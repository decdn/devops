#!/usr/bin/env python3
"""Stub sponsord-onramp binary for the Molecule scenarios.

Stands in for the real `sponsord-onramp` so the role can be exercised end to end
without a release or a Turnstile account:

  * `--version` -> print a version line and exit 0 (the role's version backstop).
  * no argument -> enforce the startup contract the real onramp enforces, then
                   serve on ONRAMP_BIND until killed:
                     - ONRAMP_PUBLIC_URL, _RPC_URL, _CAPACITY_BOND_ADDR,
                       _TURNSTILE_SITEKEY and the four release-pin variables set;
                     - ONRAMP_DAEMON_TOKEN_FILE readable and >= 32 bytes;
                     - ONRAMP_TURNSTILE_SECRET_FILE readable and non-empty;
                     - ONRAMP_BRAND_NAME, when set, equal to EXPECTED_BRAND byte for
                       byte (proves the role's EnvironmentFile quoting);
                     - ONRAMP_BIND and ONRAMP_DAEMON_URL set (no fallback, so a
                       template that drops either is caught);
                     - ONRAMP_GATE_TEMPLATE, when set, readable by this unit;
                     - the daemon at ONRAMP_DAEMON_URL answers /v1/info for the
                       token in ONRAMP_DAEMON_TOKEN_FILE (upstream reads /v1/info at
                       start and exits if it can't).
                   Any violation exits 1 with the reason on stderr (the journal).
                   The marker file UNHEALTHY_MARKER makes it exit 1 on start,
                   which is how the scenario proves the readiness gate is fatal.
                   Routes: /healthz, and /molecule/client-ip, which echoes the
                   header named by ONRAMP_CLIENT_IP_HEADER, so the scenario can
                   check what Caddy passes on as the client address.
  * anything else -> exit 2.
"""
import os
import sys
import urllib.request
from http.server import BaseHTTPRequestHandler, HTTPServer

VERSION = "sponsord-onramp 0.0.0-molecule-stub"
UNHEALTHY_MARKER = "/etc/sponsord/onramp-stub-unhealthy"
# Must match sponsord_onramp_brand_name in the scenario's inventory.
EXPECTED_BRAND = 'deCDN "molecule" $HOME'
REQUIRED = (
    "ONRAMP_BIND", "ONRAMP_DAEMON_URL", "ONRAMP_PUBLIC_URL", "ONRAMP_RPC_URL", "ONRAMP_CAPACITY_BOND_ADDR", "ONRAMP_TURNSTILE_SITEKEY",
    "ONRAMP_DECDN_RELEASE", "ONRAMP_DECDN_SUMS_SHA256", "ONRAMP_CLI_RELEASE", "ONRAMP_CLI_SUMS_SHA256",
)


def die(msg):
    print(f"sponsord-onramp-stub: {msg}", file=sys.stderr)
    sys.exit(1)


def read_secret(var):
    path = os.environ.get(var)
    if not path:
        die(f"{var} is not set")
    try:
        with open(path, "rb") as f:
            value = f.read()
    except OSError as e:
        die(f"{var}: cannot read {path}: {e}")
    value = value.removesuffix(b"\n").removesuffix(b"\r")
    if not value:
        die(f"{var}: {path} is empty")
    return value


def check_startup():
    if os.path.exists(UNHEALTHY_MARKER):
        die(f"{UNHEALTHY_MARKER} exists: refusing to start")
    for var in REQUIRED:
        if not os.environ.get(var):
            die(f"{var} is not set")
    if os.environ.get("ONRAMP_BRAND_NAME", EXPECTED_BRAND) != EXPECTED_BRAND:
        die("ONRAMP_BRAND_NAME does not match the inventory literal (EnvironmentFile quoting broke it)")
    token = read_secret("ONRAMP_DAEMON_TOKEN_FILE")
    if len(token) < 32:
        die("daemon token is shorter than 32 bytes")
    read_secret("ONRAMP_TURNSTILE_SECRET_FILE")
    template = os.environ.get("ONRAMP_GATE_TEMPLATE")
    if template:
        try:
            with open(template, "rb") as f:
                f.read()
        except OSError as e:
            die(f"ONRAMP_GATE_TEMPLATE {template}: {e}")
    daemon = os.environ["ONRAMP_DAEMON_URL"]
    req = urllib.request.Request(f"{daemon}/v1/info", headers={"Authorization": "Bearer " + token.decode()})
    try:
        with urllib.request.urlopen(req, timeout=5) as r:
            if r.status != 200:
                die(f"daemon {daemon} answered {r.status}")
    except OSError as e:
        die(f"daemon {daemon}/v1/info failed (unreachable, or the token is not the daemon's): {e}")


class Handler(BaseHTTPRequestHandler):
    def do_GET(self):
        if self.path == "/healthz":
            body = b'{"ok":true}'
        elif self.path == "/molecule/client-ip":
            header = os.environ.get("ONRAMP_CLIENT_IP_HEADER", "")
            body = (self.headers.get(header, "") if header else self.client_address[0]).encode()
        else:
            self.send_error(404)
            return
        self.send_response(200)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def log_message(self, *args):
        pass


def main():
    if sys.argv[1:] == ["--version"]:
        print(VERSION)
        return
    if sys.argv[1:]:
        print(f"sponsord-onramp-stub: unexpected arguments {sys.argv[1:]}", file=sys.stderr)
        sys.exit(2)
    check_startup()
    host, _, port = os.environ["ONRAMP_BIND"].rpartition(":")
    HTTPServer((host, int(port)), Handler).serve_forever()


if __name__ == "__main__":
    main()
