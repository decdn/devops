# Galaxy collections vendored by `make deps`
collections/

# Per-node RPC secret only (may embed an API key). Everything else in host_vars —
# main.yml (contract addresses, region, cache origin, …) — is committable template
# config. hosts.yml is committable too (your fork's inventory is yours to track).
inventory/host_vars/*/secret.yml
!inventory/host_vars/*/secret.yml.example

# Ansible / molecule scratch
*.retry
.molecule/
