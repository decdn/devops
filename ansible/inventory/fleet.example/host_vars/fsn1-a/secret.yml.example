# OPTIONAL, and only in the PRIVATE overlay. The preferred posture is to provision a
# 0600 /etc/decdn/decdn.env on the host and leave this file absent, so the RPC URL
# never touches the control machine. See roles/decdn_node/README.md § Secrets.
# To use it, copy to secret.yml beside this file and keep it git-ignored.
decdn_rpc_url: ""   # SENSITIVE; may embed an API key
