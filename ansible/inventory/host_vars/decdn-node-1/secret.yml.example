---
# Per-node SECRETS for decdn-node-1 — the INVENTORY path, which is optional.
#
# You only need this file if you want the role to author /etc/decdn/decdn.env for
# you. The preferred posture is the other way round: provision that 0600 file on
# the target host (see roles/decdn_node/files/decdn.env.example) and skip this
# file entirely — the secret then never sits in plaintext on your control machine
# and never transits it on a converge. The role fails loud if NEITHER exists.
#
# If you do use it: copy to secret.yml (same directory, git-ignored) and fill in.
# Ansible merges it with main.yml for this host. These are the ONLY per-node
# values kept out of git — everything else lives in the committed main.yml.
#
# SENSITIVE (may embed an API key). Setting this makes the role REWRITE
# /etc/decdn/decdn.env from these values on every run, discarding any lines added
# on the host. The public endpoint below works for light use; run your own or use
# a provider for production reliability.
decdn_rpc_url: "https://sepolia-rollup.arbitrum.io/rpc"

# Optional, and only meaningful alongside decdn_rpc_url above (the role writes the
# env file all-or-nothing, and rejects extra_env against a host-provisioned file
# rather than silently dropping it). Extra KEY: value pairs appended to the 0600
# /etc/decdn/decdn.env that systemd hands the daemon — most notably the AWS
# credentials backing an S3 cache origin, which the role deliberately does NOT
# write into node.toml (that file is 0640 and diffable):
#
# decdn_extra_env:
#   AWS_ACCESS_KEY_ID: "AKIA..."
#   AWS_SECRET_ACCESS_KEY: "..."
#   AWS_SESSION_TOKEN: "..."        # only for assume-role / SSO flows
#
# Pair that with decdn_cache_origin_s3_use_default_chain: true in main.yml.

# --- Grafana Cloud (only when decdn_grafana_cloud_enabled is on) ---------------
#
# The opt-in observability agent accepts its API token through the same channel:
# set grafana_alloy_api_token here and the role authors /etc/grafana-alloy.env on
# the host for you (token-only, root 0600), skipping the hand-provisioning shown
# in roles/grafana_alloy/files/grafana-alloy.env.example. SENSITIVE — leave it
# commented out to keep the operator-provisioned host path instead.
#
# grafana_alloy_api_token: "glc_example_token_replace_me"
