# MANAGED BY the sponsord_onramp role — do not edit by hand.
#
# The public side of sponsord-onramp: TLS for {{ sponsord_onramp_domain }}, then a
# reverse proxy to the onramp on loopback. Caddy redirects http to https and,
# with no trusted_proxies, replaces any client-sent X-Forwarded-For with the real
# client address, which the onramp rate limits by.
{
	# No admin API: nothing on this host may reconfigure the proxy over loopback.
	# Config changes restart Caddy instead of reloading it.
	admin off
{% if sponsord_onramp_acme_email | length > 0 %}
	email {{ sponsord_onramp_acme_email }}
{% endif %}
}

{{ sponsord_onramp_domain }} {
{% if sponsord_onramp_caddy_tls == 'internal' %}
	# Caddy's local CA: for staging and tests only, browsers do not trust it.
	tls internal
{% endif %}
	reverse_proxy {{ sponsord_onramp_bind_address }}:{{ sponsord_onramp_port }}
}
