# MANAGED BY the sponsord_onramp role — do not edit by hand. NO secrets: the
# daemon's API token and the Turnstile secret reach the onramp as systemd
# credentials (see sponsord-onramp.service). Every value here is non-secret; the
# RPC URL and the contract addresses are even served to every user.
ONRAMP_BIND={{ sponsord_onramp_bind_address }}:{{ sponsord_onramp_port }}
ONRAMP_DAEMON_URL={{ sponsord_onramp_daemon_url }}
ONRAMP_PUBLIC_URL={{ sponsord_onramp_public_url }}
ONRAMP_RPC_URL={{ sponsord_onramp_rpc_url }}
ONRAMP_CAPACITY_BOND_ADDR={{ sponsord_onramp_capacity_bond_address }}
ONRAMP_GATE=turnstile
ONRAMP_TURNSTILE_SITEKEY={{ sponsord_onramp_turnstile_sitekey }}
ONRAMP_DECDN_RELEASE={{ sponsord_onramp_decdn_release }}
ONRAMP_DECDN_SUMS_SHA256={{ sponsord_onramp_decdn_sums_sha256 }}
ONRAMP_CLI_RELEASE={{ sponsord_onramp_cli_release }}
ONRAMP_CLI_SUMS_SHA256={{ sponsord_onramp_cli_sums_sha256 }}
{% if sponsord_onramp_brand_name | length > 0 %}
{# to_json: double-quoted with \" and \\ escaped, which systemd's EnvironmentFile
   parser unescapes (preflight refuses control characters, so no other escape is
   emitted). #}
ONRAMP_BRAND_NAME={{ sponsord_onramp_brand_name | string | to_json(ensure_ascii=false) }}
{% endif %}
{% if sponsord_onramp_gate_template_src | length > 0 %}
ONRAMP_GATE_TEMPLATE={{ sponsord_onramp_gate_template_file }}
{% endif %}
{% for name, value in [
     ('ONRAMP_SLASH_JUDGE_ADDR', sponsord_onramp_slash_judge_address),
     ('ONRAMP_CLIENT_IP_HEADER', sponsord_onramp_client_ip_header),
     ('ONRAMP_MIN_CLI_VERSION', sponsord_onramp_min_cli_version),
     ('ONRAMP_RELEASES_BASE', sponsord_onramp_releases_base),
     ('ONRAMP_SPENDING_CAP_MICRO_USDC', sponsord_onramp_spending_cap_micro_usdc),
     ('ONRAMP_TTL_SECS', sponsord_onramp_ttl_secs),
     ('ONRAMP_FUND_RATE_PER_MIN', sponsord_onramp_fund_rate_per_min),
     ('ONRAMP_POLL_RATE_PER_MIN', sponsord_onramp_poll_rate_per_min),
   ] if value | string | length > 0 %}
{{ name }}={{ value }}
{% endfor %}
