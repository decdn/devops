#!/bin/sh
# MANAGED BY the sponsord_onramp role — do not edit by hand.
#
# lego's deploy hook (sponsord-onramp-certs.service): lego runs it only after it has
# created or renewed the certificate, never after a run that found nothing due. So
# this is where a certificate counts as issued for <server> <domain>: record that,
# stop forcing a reissue of that same certificate, and reload nginx onto it. A
# force for another server or domain (the role reconfigured while this run was
# under way) is left for the run it belongs to.
#   certs-deployed <server> <domain> <record file> <force env file>
set -eu
umask 077
printf '%s %s\n' "$1" "$2" >"$3.new"
mv -f -- "$3.new" "$3"
if [ -f "$4" ] && grep -qxF "SPONSORD_ONRAMP_FORCE_FOR=$1 $2" -- "$4"; then
  rm -f -- "$4"
fi
exec /usr/bin/systemctl try-reload-or-restart nginx.service
