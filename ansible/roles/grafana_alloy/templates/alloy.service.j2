# MANAGED BY the grafana_alloy role — do not edit by hand.
#
# Runs Grafana Alloy as the dedicated, unprivileged `{{ grafana_alloy_user }}`
# user. Both OTLP receivers and Alloy's own admin server are pinned to loopback
# (AGENTS.md hard rule 2): nothing here faces public traffic, so no firewall hole
# exists. The credential env file is read by systemd as ROOT before privileges
# drop, so the agent never needs (and must not get) direct read access.
[Unit]
Description=Grafana Alloy telemetry agent (deCDN node observability)
Documentation=https://grafana.com/docs/alloy/
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User={{ grafana_alloy_user }}
Group={{ grafana_alloy_group }}

# Sensitive: GC_PROM_REMOTE_WRITE_URL / GC_PROM_USERNAME / GC_API_TOKEN /
# GC_OTLP_ENDPOINT. Root-owned 0600, read by systemd as root and handed to the
# process environment, where config.alloy picks each value up via sys.env().
# (Alloy has NO --config.expand-env flag — passing one is an immediate
# crash-loop; `sys.env` is the supported indirection.)
EnvironmentFile={{ grafana_alloy_secret_file }}

ExecStart={{ grafana_alloy_bin_effective }} run \
    --server.http.listen-addr={{ grafana_alloy_server_http_addr }} \
    --storage.path={{ grafana_alloy_state_dir }}/data \
    {{ grafana_alloy_config_file }}

# Graceful stop cap: flush the exporter queue on SIGTERM before SIGKILL would cut
# buffered telemetry loose.
KillSignal=SIGTERM
TimeoutStopSec={{ grafana_alloy_stop_timeout_sec }}

Restart=on-failure
RestartSec=5
{% if grafana_alloy_logs_enabled | default(false) | bool and (_ga_journal_groups | default([]) | length > 0) %}

# Journal access. Reading the systemd journal as a non-root user requires
# membership in systemd-journal AND adm — without them loki.source.journal starts
# without error and collects NOTHING, which is the worst possible failure mode.
# The role joins {{ grafana_alloy_user }} to these groups too; only groups that
# actually exist on this host are listed, because systemd refuses to start a unit
# naming a group that does not exist.
SupplementaryGroups={{ _ga_journal_groups | default([]) | join(' ') }}
{% endif %}

# --- Hardening ---------------------------------------------------------------
# Mirrors decdn-node.service: strict filesystem, privilege boundary, syscall
# filter. StateDirectory owns {{ grafana_alloy_state_dir }} (the only writable
# path under ProtectSystem=strict): WAL/queue state lives there, including
# loki.source.journal's positions file.
StateDirectory={{ grafana_alloy_state_dir | regex_replace('^/var/lib/', '') }}
StateDirectoryMode=0750
NoNewPrivileges=true
ProtectSystem=strict
{% if grafana_alloy_host_metrics_enabled | default(false) | bool %}
# read-only, NOT true: ProtectHome=true replaces /home, /root and /run/user with
# empty tmpfs mounts inside the unit's namespace, so node_exporter's filesystem
# collector reports those mounts as the empty overlay instead of the real disk —
# a full /home would never raise an alert. read-only keeps the privilege boundary
# (the agent still cannot write there) while reporting true usage.
ProtectHome=read-only
{% else %}
ProtectHome=true
{% endif %}
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectClock=true
# AF_INET/AF_INET6 for the loopback OTLP/scrape/remotes; AF_UNIX for journald and
# for the D-Bus system bus the node_exporter `systemd` collector queries.
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
RestrictSUIDSGID=true
LockPersonality=true
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
