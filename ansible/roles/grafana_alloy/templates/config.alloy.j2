{# Two runtimes, one template. `systemd` (the role; the default) renders one
   host's identity in as literals. `compose` renders compose/alloy/config.alloy,
   a committed mirror that every Compose host runs unchanged
   (scripts/render-compose-alloy.sh; ansible/tests/alloy-config/render.yml has
   the case): it reads the host's identity, and which daemons the host runs, from
   the container's environment at runtime, reaches the host's /proc, /sys and /
   through read-only bind mounts under /host, and tells the containers' journal
   lines apart by container name. _ga_runtime is set by those renders only; it is
   not an operator knob. #}
{% set ga_compose = (_ga_runtime | default('systemd')) == 'compose' %}
{% if ga_compose %}
{#- The identity values become sys.env lookups: ga_str below renders a value
    carrying this prefix as one. The prefix cannot collide with a real value,
    whose charset preflight limits to [A-Za-z0-9._/-]. #}
{% set _ga_instance_id = 'sys.env:ALLOY_INSTANCE_ID' %}
{% set grafana_alloy_region = 'sys.env:ALLOY_REGION' %}
{% set grafana_alloy_deployment_environment = 'sys.env:ALLOY_DEPLOYMENT_ENVIRONMENT' %}
// GENERATED from ansible/roles/grafana_alloy/templates/config.alloy.j2 by
// scripts/render-compose-alloy.sh — do not edit by hand: change the template and
// regenerate (`make test-scripts` fails while this file differs from a fresh
// render). compose/compose.yaml's `alloy` service runs it (compose/README.md).
{% else %}
// MANAGED BY the grafana_alloy Ansible role — do not edit by hand.
{% endif %}
//
// Alloy's configuration syntax only understands `//` and `/* */` comments — a
// `#` is an illegal character that aborts the parse, so every comment in this
// file (and everything the Jinja layer emits) must stay `//`.
//
// Pipeline: scrape the node's /metrics and push it to Grafana Cloud Prometheus;
// scrape the MACHINE (Alloy's in-process node_exporter) and Alloy itself; ship
// journald to Grafana Cloud Loki; receive OTLP traces (plus any logs/metrics
// pushed over localhost) on gRPC 4317 / HTTP 4318 bound to loopback only; stamp
// resource identity on everything, probabilistically sample traces, batch, then
// export via OTLP/HTTP.
//
{% if ga_compose %}
// Secrets are NOT literals here: every credential is read at config-load time
// with the `sys.env` stdlib function from the root-owned 0600 environment file
// Compose hands the container (env_file ALLOY_ENV_FILE, /etc/grafana-alloy.env
// by default: the same file the Ansible role's unit reads; template:
// compose/grafana-alloy.env.example). Alloy has no `--config.expand-env` flag —
// `${VAR}` inside a string is a literal, so `sys.env("VAR")` is the only working
// indirection.
//
// The host's identity (ALLOY_INSTANCE_ID, ALLOY_REGION,
// ALLOY_DEPLOYMENT_ENVIRONMENT) and the active profiles (DECDN_COMPOSE_PROFILES)
// come from compose.yaml's `environment:`, which reads them from .env.
{% else %}
// Secrets are NOT literals here: every credential is read at config-load time
// with the `sys.env` stdlib function from the root-owned 0600 environment file
// systemd hands the unit (EnvironmentFile= in alloy.service; operator template:
// roles/grafana_alloy/files/grafana-alloy.env.example). Alloy has no
// `--config.expand-env` flag — `${VAR}` inside a string is a literal, so
// `sys.env("VAR")` is the only working indirection.
//
// The NON-secret half of the credentials (endpoint URLs, the three numeric
// instance IDs) may instead come from inventory; see the ga_endpoint macro.
{% endif %}

{# Renders a Grafana Cloud connection value as either an inline string literal
   (when inventory set it) or the sys.env lookup this role has always used (when
   inventory left it empty). Keeping both shapes means a host provisioned the old
   way — all keys in /etc/grafana-alloy.env — renders exactly the previous
   configuration, while a host driven from inventory needs only GC_API_TOKEN on
   disk. tojson does the quoting/escaping in both branches.
   NEVER call this for the API token: config.alloy is 0644 on the host.
   The `| string` is load-bearing: instance IDs are numeric, so an unquoted
   `grafana_alloy_prom_username: 1234567` in inventory arrives as an int, which
   has no length and which tojson would emit as a bare number — and Alloy's
   basic_auth username is a string, so that is a config-load failure. #}
{% macro ga_endpoint(value, env_key) -%}
{% set ga_value = value | default('', true) | string %}
{% if ga_value | length > 0 %}{{ ga_value | tojson }}{% else %}sys.env({{ env_key | tojson }}){% endif %}
{%- endmacro %}

{# The OTLP gateway's basic-auth username is the STACK instance ID, which is not
   necessarily the Prometheus one — where they differ, reusing the Prometheus ID
   401s the whole OTLP pipeline while remote-write and Loki stay healthy.
   Inventory wins; otherwise the decision is deferred to RUNTIME, because whether
   the host's env file carries GC_OTLP_USERNAME is not knowable at render time.
   `coalesce` returns its first non-empty argument and sys.env yields "" for an
   unset variable, so an existing host with only the Prometheus key keeps
   resolving exactly the value it resolved before. #}
{% macro ga_otlp_username() -%}
{% set ga_otlp_user = grafana_alloy_otlp_username | default('', true) | string %}
{% if ga_otlp_user | length > 0 %}{{ ga_otlp_user | tojson }}{% else %}coalesce(sys.env("GC_OTLP_USERNAME"), {{ ga_endpoint(grafana_alloy_prom_username, 'GC_PROM_USERNAME') }}){% endif %}
{%- endmacro %}

{# An identity value: a string literal, or (the compose runtime, see the top) the
   sys.env lookup its 'sys.env:' prefix names. #}
{% macro ga_str(value) -%}
{% if value is string and value.startswith('sys.env:') %}sys.env({{ value[8:] | tojson }}){% else %}{{ value | tojson }}{% endif %}
{%- endmacro %}
{# The compose runtime's scrape targets: the target exists only while
   COMPOSE_PROFILES (passed in as DECDN_COMPOSE_PROFILES) names a profile that
   starts the daemon, so a host without it has no target at all, and no
   up == 0 series for an alert such as DecdnNodeDown to fire on. Relabel regexes
   are anchored; the commas around the list make each name match whole. #}
{% macro ga_compose_targets(name, address, job, profiles) -%}
// Scraped only while COMPOSE_PROFILES starts it ({{ profiles | join(' or ') }}).
discovery.relabel "{{ name }}_targets" {
  targets = [
    { "__address__"      = {{ address | tojson }},
      "instance"         = sys.env("ALLOY_INSTANCE_ID"),
{% if job | length > 0 %}
      "job"              = {{ job | tojson }},
{% endif %}
      "__decdn_profiles" = string.format(",%s,", sys.env("DECDN_COMPOSE_PROFILES")) },
  ]

  rule {
    source_labels = ["__decdn_profiles"]
    regex         = `.*,\s*(?:{{ (profiles + ['\\*']) | join('|') }})\s*,.*`
    action        = "keep"
  }
}
{% endmacro %}
{# The decdn-node scrape, off on a host that runs no node (grafana_alloy_node_enabled;
   playbooks/group_vars/all.yml derives it from the decdn_nodes group). #}
{% if grafana_alloy_node_enabled | bool %}
{% if ga_compose %}
{{ ga_compose_targets('decdn_node', '127.0.0.1:' ~ decdn_metrics_port | default(9090), grafana_alloy_node_job, _ga_compose_profiles.decdn_node) }}
prometheus.scrape "decdn_node" {
  targets         = discovery.relabel.decdn_node_targets.output
{% else %}
prometheus.scrape "decdn_node" {
  targets = [
    { "__address__" = "127.0.0.1:{{ decdn_metrics_port | default(9090) }}",
      "instance"    = {{ ga_str(_ga_instance_id) }}{% if grafana_alloy_node_job | length > 0 %},
      {# BREAKING-CHANGE ESCAPE HATCH: with no explicit job label Alloy falls back
         to the component ID, so these series used to be job="prometheus.scrape.decdn_node".
         Set grafana_alloy_node_job: "" to keep the old identity for dashboards
         and alerts that already hard-code it. #}
      "job"         = {{ grafana_alloy_node_job | tojson }}{% endif %} },
  ]
{% endif %}
  forward_to      = [prometheus.relabel.decdn_identity.receiver]
  scrape_interval = {{ grafana_alloy_scrape_interval | to_json }}
}

{# Low-cardinality identity labels shipped with every metric. Prom label NAMES
   may not contain '.', so the dotted service.* naming flattens to underscores;
   empty values omit their rule entirely. #}
{% set ga_metric_labels = [
     ["service_name", grafana_alloy_service_name],
     ["service_namespace", grafana_alloy_service_namespace],
     ["service_instance_id", _ga_instance_id],
     ["deployment_environment", grafana_alloy_deployment_environment],
     ["region", grafana_alloy_region],
   ] %}
prometheus.relabel "decdn_identity" {
  forward_to = [prometheus.remote_write.cloud.receiver]
{% for name, value in ga_metric_labels if value | length > 0 %}

  rule {
    target_label = {{ name | tojson }}
    replacement  = {{ ga_str(value) }}
  }
{% endfor %}
}

{% endif %}
{% if grafana_alloy_sponsord_enabled | bool %}
{# sponsord's own /metrics (pool balance, keeper top-ups, issued capabilities) on
   its loopback listener — the same port as its API, but /metrics needs no token.
