{# ---------------------------------------------------------------------------
   HOST (machine) METRICS — Alloy's in-process node_exporter.

   Runs inside the agent: no extra listener and no extra port, so the
   loopback-only posture is unchanged. Identity is applied with
   discovery.relabel (TARGET labels — evaluated once per target, then attached to
   every sample at scrape time) rather than prometheus.relabel (per SAMPLE, with
   a cardinality-sized cache). The scrape forwards STRAIGHT to remote_write,
   deliberately bypassing prometheus.relabel.decdn_identity: that component
   stamps service_name (default decdn-node), which is false for machine series.

   `job` must stay integrations/node_exporter for Grafana Cloud's prebuilt Linux
   Server dashboards and alert rules to find these series.
   Every regex below is JSON-encoded, so no value can break out of its string. #}
{% if grafana_alloy_host_metrics_enabled | bool %}
{# Upstream applies disable_collectors FIRST and enable_collectors second, so a
   name in both ends up ENABLED — the opposite of what an operator vetoing a
   collector expects. Subtract the veto list here instead, so it really wins and
   so the derived `systemd` block below agrees with what actually runs.
   The compose runtime also drops `systemd`: it would need the host's D-Bus
   socket mounted into the container, and the containers are not units anyway. #}
{% set ga_host_veto = grafana_alloy_host_disable_collectors + (['systemd'] if ga_compose else []) %}
{% set ga_host_set_collectors = grafana_alloy_host_collectors
     | reject('in', ga_host_veto) | list %}
{% set ga_host_extra_collectors = grafana_alloy_host_extra_collectors
     | reject('in', ga_host_veto) | list %}
{% set ga_host_enabled_collectors = ga_host_set_collectors + ga_host_extra_collectors %}

prometheus.exporter.unix "host" {
  // set_collectors REPLACES the default set (~45 collectors): anything not
  // listed is off. enable_collectors adds on top (it is the only way to turn on
  // an upstream-defaultDisabled collector such as systemd). Both lists already
  // have grafana_alloy_host_disable_collectors subtracted at render time.
  set_collectors           = {{ ga_host_set_collectors | tojson }}
{% if ga_host_extra_collectors | length > 0 %}
  enable_collectors        = {{ ga_host_extra_collectors | tojson }}
{% endif %}
{% if grafana_alloy_host_disable_collectors | length > 0 %}
  disable_collectors       = {{ grafana_alloy_host_disable_collectors | tojson }}
{% endif %}
  include_exporter_metrics = {{ grafana_alloy_host_include_exporter_metrics | bool | tojson }}
{% if ga_compose %}

  // The host as compose.yaml mounts it, read-only: its /proc (the host's PID
  // namespace, so the host's mounts), /sys and / (rslave, so later mounts show).
  // The filesystem collector strips rootfs_path from every mount point, so the
  // exclusion regex below matches host paths, as on the systemd path. diskstats
  // reads the host's udev database for its device labels.
  procfs_path              = "/host/proc"
  sysfs_path               = "/host/sys"
  rootfs_path              = "/host/root"
  udev_data_path           = "/host/root/run/udev/data"
{% endif %}

  filesystem {
    fs_types_exclude     = {{ grafana_alloy_host_fs_types_exclude | tojson }}
    mount_points_exclude = {{ grafana_alloy_host_mount_points_exclude | tojson }}
    mount_timeout        = {{ grafana_alloy_host_mount_timeout | to_json }}
  }

  netdev {
    device_exclude = {{ grafana_alloy_host_netdev_device_exclude | tojson }}
  }

  // `disk` is the block name for the diskstats collector.
  disk {
    device_exclude = {{ grafana_alloy_host_disk_device_exclude | tojson }}
  }
{% if 'systemd' in ga_host_enabled_collectors %}

  // Per-unit state. Reaches systemd over the D-Bus SYSTEM bus (Alloy does not
  // expose node_exporter's root-only private-socket mode), so it needs AF_UNIX
  // and /run/dbus/system_bus_socket — both available to the hardened unit, and
  // both absent in a bare container, where it simply reports nothing.
  systemd {
    unit_include = {{ grafana_alloy_host_systemd_unit_include | tojson }}
    unit_exclude = {{ grafana_alloy_host_systemd_unit_exclude | tojson }}
  }
{% endif %}
}

{# Host series carry job/instance (what the Cloud dashboards filter on) plus the
   fleet-identity labels, but NOT service_name: these describe the machine, not
   the daemon. Empty values drop their rule entirely. #}
{% set ga_host_labels = [
     ["job", grafana_alloy_host_job],
     ["instance", _ga_instance_id],
     ["service_namespace", grafana_alloy_service_namespace],
     ["deployment_environment", grafana_alloy_deployment_environment],
     ["region", grafana_alloy_region],
   ] %}
discovery.relabel "host" {
  targets = prometheus.exporter.unix.host.targets
{% for name, value in ga_host_labels if value | length > 0 %}

  rule {
    target_label = {{ name | tojson }}
    replacement  = {{ ga_str(value) }}
  }
{% endfor %}
}

prometheus.scrape "host" {
  targets         = discovery.relabel.host.output
  forward_to      = [prometheus.remote_write.cloud.receiver]
  scrape_interval = {{ grafana_alloy_host_scrape_interval | to_json }}
}
{% endif %}
{% if grafana_alloy_self_metrics_enabled | bool %}

{# Alloy's own health: component evaluation, WAL, remote-write queue and
