{% else %}
prometheus.scrape "sponsord" {
  targets = [
    { "__address__" = {{ (sponsord_bind_address | default('127.0.0.1') ~ ':' ~ sponsord_port | default(8090)) | tojson }},
      "instance"    = {{ ga_str(_ga_instance_id) }},
