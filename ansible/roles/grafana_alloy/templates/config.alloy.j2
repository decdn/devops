{% set ga_self_labels = [
     ["job", grafana_alloy_self_job],
     ["instance", _ga_instance_id],
     ["service_namespace", grafana_alloy_service_namespace],
     ["deployment_environment", grafana_alloy_deployment_environment],
     ["region", grafana_alloy_region],
   ] %}
discovery.relabel "alloy_self" {
  targets = prometheus.exporter.self.alloy.targets
{% for name, value in ga_self_labels if value | length > 0 %}

  rule {
    target_label = {{ name | tojson }}
    replacement  = {{ ga_str(value) }}
  }
{% endfor %}
}

prometheus.scrape "alloy_self" {
  targets         = discovery.relabel.alloy_self.output
  forward_to      = [prometheus.remote_write.cloud.receiver]
  scrape_interval = {{ grafana_alloy_host_scrape_interval | to_json }}
}
{% endif %}
{% if grafana_alloy_logs_enabled | bool %}

{# ---------------------------------------------------------------------------
   HOST + SERVICE LOGS — journald to Grafana Cloud Loki.

   Two relabel stages, and the split is not cosmetic: journald fields arrive as
   __journal*-prefixed labels that are STRIPPED before entries reach any
   downstream receiver, so anything reading them (the field mapping AND the
   cost-guardrail drops) MUST live in the rules-only ruleset consumed by
   loki.source.journal. Identity labels are applied afterwards, on the entries.

   Reading the journal needs group membership (systemd-journal + adm), granted by
   the role and pinned in the unit's SupplementaryGroups — without it the
   component starts happily and collects nothing at all. The positions file lands
   under --storage.path, i.e. inside the existing StateDirectory. #}
loki.relabel "journal_rules" {
  // Rules-only usage: the ruleset is consumed via .rules below, so nothing is
  // forwarded from here. The argument is still required.
  forward_to = []

  rule {
    source_labels = ["__journal__systemd_unit"]
    target_label  = "unit"
  }
{% if ga_compose %}

  // Compose: dockerd writes every container's lines (the journald logging
  // driver), so their _SYSTEMD_UNIT is docker.service. CONTAINER_NAME tells them
  // apart: `container` keeps it, and this project's containers (project name
  // decdn, so decdn-<service>-<n>) get the unit their Ansible role installs, so
  // the level, guardrail and service_name rules below, and the log panels in
  // monitoring/, match the same streams on both paths.
  rule {
    source_labels = ["__journal_container_name"]
    target_label  = "container"
  }

  rule {
    source_labels = ["__journal_container_name"]
    regex         = {{ ('decdn-(' ~ _ga_compose_units | join('|') ~ ')-[0-9]+') | tojson }}
    target_label  = "unit"
    replacement   = "${1}.service"
  }
{% endif %}

  rule {
    source_labels = ["__journal__hostname"]
    target_label  = "hostname"
  }

  rule {
    source_labels = ["__journal_priority_keyword"]
    target_label  = "level"
  }

  rule {
    source_labels = ["__journal__transport"]
    target_label  = "transport"
  }

  rule {
    source_labels = ["__journal__boot_id"]
    target_label  = "boot_id"
  }
{# The units that log tracing-subscriber's plain text (the sponsord daemon, its
   onramp, iroh-relay and iroh-dns-server), parsed for a level by loki.process
   "daemon_level" below. #}
{% set ga_text_units = (['sponsord'] if grafana_alloy_sponsord_enabled | bool else [])
     + (['sponsord-onramp'] if grafana_alloy_sponsord_onramp_enabled | bool else [])
     + (['iroh-relay'] if grafana_alloy_iroh_relay_enabled | bool else [])
     + (['iroh-dns-server'] if grafana_alloy_iroh_dns_server_enabled | bool else []) %}
{% if grafana_alloy_logs_drop_priority_regex | length > 0 %}

  // Cost guardrail: the regex is anchored to the WHOLE value by Prometheus
  // relabel semantics, so "debug" drops debug and nothing else.
  //
  // decdn-node{% if ga_text_units %} and {{ ga_text_units | join(' and ') }} are{% else %} is{% endif %} exempt: journald reports every line it writes as info, so
  // judging it by priority would be judging it by a level it never set (a
  // regex containing "info" would drop its errors). loki.process
  // "daemon_level" below applies the same regex to its real{% if not ga_text_units %}, JSON{% endif %} level. The
  // exemption blanks a scratch copy of the keyword for that one unit; like
  // every __-prefixed label it never leaves this ruleset.
  rule {
    source_labels = ["__journal_priority_keyword"]
    target_label  = "__priority_guardrail"
  }

  rule {
    source_labels = [{{ ('unit' if ga_compose else '__journal__systemd_unit') | tojson }}]
    regex         = {{ ('(?:' ~ (['decdn-node'] + ga_text_units) | join('|') ~ ')\\.service') | tojson }}
    target_label  = "__priority_guardrail"
    replacement   = ""
  }

  rule {
    source_labels = ["__priority_guardrail"]
    regex         = {{ grafana_alloy_logs_drop_priority_regex | tojson }}
    action        = "drop"
  }
{% endif %}
{% if grafana_alloy_logs_drop_unit_regex | length > 0 %}

  // Cost guardrail: chatty units nobody debugs from Loki. Entries with no unit
  // (kernel, for example) have an empty value here and are kept.
  rule {
    source_labels = ["__journal__systemd_unit"]
    regex         = {{ grafana_alloy_logs_drop_unit_regex | tojson }}
    action        = "drop"
  }
{% endif %}
}

loki.source.journal "host" {
{% if grafana_alloy_logs_journal_path | length > 0 %}
  path           = {{ grafana_alloy_logs_journal_path | tojson }}
{% else %}
  // No path: Alloy reads both /var/log/journal and /run/log/journal.
{% endif %}
  // Bounds the catch-up burst after an outage or a fresh install.
  max_age        = {{ grafana_alloy_logs_max_age | to_json }}
  format_as_json = false
  relabel_rules  = loki.relabel.journal_rules.rules
  forward_to     = [loki.process.redact_urls.receiver]
}

{# Credentials embedded in URLs do not leave the host in journald lines. An RPC
   URL usually carries its provider API key, and a daemon error can quote it:
   sponsord's "error sending request for url (...)" does. decdn-node also strips
   URLs at the source (decdn_common::redact); sponsord does not, so for sponsord
   this stage is the only guard. It runs on EVERY unit's line, ahead of the level
   stages, and has no knob: it is the secret model, not a cost guardrail.

   Both stages key on "://" (or JSON's ":\/\/"), not a scheme list, so any
   scheme in any case is caught, as in upstream's redact_bare_urls. Unlike that
   function, the scheme and host are kept, so the provider stays identifiable:
     1. userinfo -> <redacted>. It runs to the LAST @ of the whitespace-free
        token, so a password holding an unencoded / ? # or @ is covered too.
        The cost: a URL with an @ in its path loses its host
        (https://h/users/@x/y ships as https://<redacted>@x/<redacted>).
     2. everything from the first / ? # (or \/) after the host -> /<redacted>,
        whichever separator it was.
   A URL with no userinfo and nothing after its host, and a line with no URL,
   pass through unchanged.

   The redacted text ends at whitespace, '"' or '\"' and over-consumes anything
   else, such as a closing ')' (legal in a path; losing a bracket beats leaking
   a key). JSON escapes are read as whole pairs (\u0026, \/, \\), so Go's
   encoding/json, PHP's json_encode and one level of JSON nested in a JSON
   string are all covered, and the line stays valid JSON for the level stage
   below. stage.replace rewrites every match on the line.

   Not covered: a \u002f-escaped separator, a fully percent-encoded URL, deeper
   JSON nesting, a URL journald split across two records (lines over LineMax,
   48K by default) and a Debug-printed url::Url struct. OTLP data does not pass
   through here (#86). A line no expression matches ships as it was, so keep
   `replace` a literal: a template that fails to render also passes the line
   through. validate.sh runs these stages in the real Alloy against sample
   lines. #}
loki.process "redact_urls" {
  forward_to = [loki.process.daemon_level.receiver]

  // 1. userinfo (as upstream's redact_userinfo, which writes ***@ instead).
  stage.replace {
    expression = `:\\?/\\?/((?:\\[^\s"]|[^\s"\\])+)@`
    replace    = "<redacted>"
  }

  // 2. path, query and fragment; the separator is normalised to /.
  stage.replace {
    expression = `:\\?/\\?/(?:\\[^\s"\\/]|[^/?#\s"\\])+((?:\\?/|[?#])(?:\\[^\s"]|[^\s"\\])*)`
    replace    = "/<redacted>"
  }
}

{# The daemon's own severity. decdn-node logs JSON to stdout, and journald gives
   every stdout line priority 6, so the journal_rules mapping above labels all of
   them level="info" — WARN and ERROR included. The real level is the `level`
   field of the tracing-subscriber JSON body, e.g. {"level":"WARN",...}.

   This runs after loki.source.journal (via redact_urls, which rewrites only
   the line), where the __journal* fields are already gone, so it keys off the
   `unit` label journal_rules produced. The unit name is the one decdn_node
   installs; it is also hard-coded in the journal_rules
   priority exemption above and the service_name rule below — a rename must be
   mirrored in all three (validate.sh pins them).

   Only the five tracing levels are accepted, trimmed and case-folded, and WARN
   becomes journald's `warning`; DEBUG/INFO/ERROR already match journald's
   keywords. TRACE stays `trace`, which journald has no keyword for, so the
   priority guardrail default lists it explicitly. Anything else — a line that
   is not JSON (log_format = "pretty", or a panic written raw to stderr), JSON
   with no level, or an unexpected value — leaves decdn_level unset (the
   template stage deletes a key it renders empty), so stage.labels and
   stage.drop skip the line and its journald level stands. #}
{# The stages after a daemon's own level extraction are identical for both
   daemons: normalise, label, and apply the guardrail to the real level. #}
{% macro ga_daemon_level_stages() %}
    stage.template {
      source   = "decdn_level"
      template = {% raw %}`{{ $l := ToLower (TrimSpace (print .Value)) }}{{ if eq $l "warn" "warning" }}warning{{ else if eq $l "trace" "debug" "info" "error" }}{{ $l }}{{ end }}`{% endraw +%}
    }

    stage.labels {
      values = { level = "decdn_level" }
    }
{% if grafana_alloy_logs_drop_priority_regex | length > 0 %}

    // The priority guardrail for the daemon, which journal_rules exempts: the
    // same regex, applied to the level the daemon actually logged. Unlike
    // relabel regexes, stage.drop is NOT anchored, hence the explicit ^...$.
    stage.drop {
      source     = "decdn_level"
      expression = {{ ('^(?:' ~ grafana_alloy_logs_drop_priority_regex ~ ')$') | tojson }}
    }
{% endif %}
{%- endmacro %}
loki.process "daemon_level" {
  forward_to = [loki.relabel.journal_identity.receiver]

  stage.match {
    selector = `{unit="decdn-node.service"}`

    stage.json {
      expressions = { decdn_level = "level" }
    }

{{ ga_daemon_level_stages() }}  }
{% if ga_text_units %}
{% set ga_text_selector = '{unit=~"(' ~ ga_text_units | join('|') ~ ')\\\\.service"}' %}

  // {{ ga_text_units | join(' and ') }} log{% if ga_text_units | length == 1 %}s{% endif %} tracing-subscriber's plain-text format with colour off
  // (NO_COLOR=1 in the units): "<timestamp>  WARN <target>: <message>". The
  // level is the second whitespace-separated field.
  stage.match {
    selector = `{{ ga_text_selector }}`

    stage.regex {
      expression = `^\S+\s+(?P<decdn_level>TRACE|DEBUG|INFO|WARN|ERROR)\s`
    }

{{ ga_daemon_level_stages() }}  }

  // What these write raw when they exit on an error carries no level field:
  // anyhow's "Error: ..." and "Caused by:" lines, and a panic message. They are
  // the lines that say WHY it stopped, so they are errors. Any other unlevelled
  // line keeps its journald level.
  stage.match {
    selector = `{{ ga_text_selector }} |~ "^(Error: |Caused by:|thread '.+' panicked)"`

    stage.template {
      source   = "decdn_level"
      template = "error"
    }

    stage.labels {
      values = { level = "decdn_level" }
    }
  }
{% endif %}
}

{# Same job/instance pair as the host metrics above — Grafana Cloud's Linux
   Server integration dashboards correlate logs and metrics on exactly these
   two labels. Set here (not via the source's `labels` argument) so they
   override the job label loki.source.journal adds on its own. #}
{% set ga_log_labels = [
     ["job", grafana_alloy_logs_job],
     ["instance", _ga_instance_id],
     ["service_namespace", grafana_alloy_service_namespace],
     ["deployment_environment", grafana_alloy_deployment_environment],
     ["region", grafana_alloy_region],
   ] %}
loki.relabel "journal_identity" {
  forward_to = [loki.write.cloud.receiver]
{% for name, value in ga_log_labels if value | length > 0 %}

  rule {
    target_label = {{ name | tojson }}
    replacement  = {{ ga_str(value) }}
  }
{% endfor %}
{% if grafana_alloy_service_name | length > 0 %}
{# service_name describes the daemon, not the machine (the same reason host
   metrics above omit it), so only the daemon's own unit gets it; every other
   unit is unaffected by this rule. `job` stays whatever the identity rules above
   set (by default the integration value), so the Linux Server log dashboards
   still match this stream too. A replace rule whose regex does not match leaves
   the stream unchanged. `unit` comes from journal_rules (__journal__systemd_unit),
   so this catches only lines the daemon process writes: systemd's own
   start/stop/crash messages about it come from PID 1 as unit="init.scope". The
   name is the unit decdn_node installs, /etc/systemd/system/decdn-node.service
   — a rename there must be mirrored here AND in the journal_rules priority
   exemption and the loki.process "daemon_level" selector above (validate.sh
   pins all three), plus grafana_alloy_host_systemd_unit_include. #}

  rule {
    source_labels = ["unit"]
    regex         = "decdn-node\\.service"
    target_label  = "service_name"
    replacement   = {{ grafana_alloy_service_name | tojson }}
  }
{% endif %}
{% if grafana_alloy_sponsord_enabled | bool and grafana_alloy_sponsord_service_name | length > 0 %}
{# The same for sponsord's stream (the unit roles/sponsord installs; also named in
   the journal_rules exemption and the daemon_level selector above). #}

  rule {
    source_labels = ["unit"]
    regex         = "sponsord\\.service"
    target_label  = "service_name"
    replacement   = {{ grafana_alloy_sponsord_service_name | tojson }}
  }
{% endif %}
{% if grafana_alloy_sponsord_onramp_enabled | bool and grafana_alloy_sponsord_onramp_service_name | length > 0 %}
{# The onramp's stream (the unit roles/sponsord_onramp installs). It has no
   /metrics, so this and the daemon_level parsing above are all it gets. #}

  rule {
    source_labels = ["unit"]
    regex         = "sponsord-onramp\\.service"
    target_label  = "service_name"
    replacement   = {{ grafana_alloy_sponsord_onramp_service_name | tojson }}
  }
{% endif %}
{% if grafana_alloy_iroh_relay_enabled | bool and grafana_alloy_iroh_relay_service_name | length > 0 %}
{# iroh-relay's stream (the unit roles/iroh_relay installs; also named in the
   journal_rules exemption and the daemon_level selector above). #}

  rule {
    source_labels = ["unit"]
    regex         = "iroh-relay\\.service"
    target_label  = "service_name"
    replacement   = {{ grafana_alloy_iroh_relay_service_name | tojson }}
  }
{% endif %}
{% if grafana_alloy_iroh_dns_server_enabled | bool and grafana_alloy_iroh_dns_server_service_name | length > 0 %}
{# iroh-dns-server's stream (the unit roles/iroh_dns_server installs; also named in
   the journal_rules exemption and the daemon_level selector above). #}

  rule {
    source_labels = ["unit"]
    regex         = "iroh-dns-server\\.service"
    target_label  = "service_name"
    replacement   = {{ grafana_alloy_iroh_dns_server_service_name | tojson }}
  }
{% endif %}
}

loki.write "cloud" {
  endpoint {
    url = {{ ga_endpoint(grafana_alloy_loki_url, 'GC_LOKI_URL') }}

    // Grafana Cloud's Loki instance ID is NOT the Prometheus one; the same
    // access-policy token authenticates both.
    basic_auth {
      username = {{ ga_endpoint(grafana_alloy_loki_username, 'GC_LOKI_USERNAME') }}
      password = sys.env("GC_API_TOKEN")
    }
  }
}
{% endif %}

otelcol.receiver.otlp "local" {
  grpc {
    endpoint = "{{ grafana_alloy_otlp_grpc_bind }}:{{ grafana_alloy_otlp_grpc_port }}"
  }

  http {
    endpoint = "{{ grafana_alloy_otlp_http_bind }}:{{ grafana_alloy_otlp_http_port }}"
  }

  output {
    traces  = [otelcol.processor.probabilistic_sampler.traces.input]
    logs    = [otelcol.processor.transform.decdn_identity.input]
    metrics = [otelcol.processor.transform.decdn_identity.input]
  }
}

{# Identity as OTLP resource attributes; unlike Prom labels these MAY use dotted
   names. Alloy ships no `otelcol.processor.resource` component, so the upstream
   collector's resource processor is expressed as OTTL `set()` statements in the
   `resource` context of otelcol.processor.transform (the supported equivalent).
   Sorted keys keep rendering byte-stable across converges (idempotence) and
   empty values drop out of the statement list entirely. Values are constrained
   to [A-Za-z0-9._/-] by preflight, so they cannot break out of the OTTL string
   literal or the enclosing backtick-quoted Alloy string. #}
{% set ga_res_attrs = {
     "deployment.environment": grafana_alloy_deployment_environment,
     "region": grafana_alloy_region,
     "service.instance.id": _ga_instance_id,
     "service.name": grafana_alloy_service_name,
     "service.namespace": grafana_alloy_service_namespace,
   } %}
{% set ga_res_statements = [] %}
{# Each statement is an Alloy expression: a backtick-quoted literal, or (an
   identity value the compose runtime reads from the environment) one built by
   string.format at load time, %q-quoted for OTTL and guarded by a `where`, so an
   empty value sets nothing, as an empty literal renders nothing. #}
{% for attr_key in ga_res_attrs.keys() | sort if ga_res_attrs[attr_key] | length > 0 %}
{% set ga_attr_value = ga_res_attrs[attr_key] %}
{% if ga_attr_value is string and ga_attr_value.startswith('sys.env:') %}
{% set _ = ga_res_statements.append(
     'string.format(`set(attributes[' ~ (attr_key | tojson) ~ '], %q) where %q != ""`, '
     ~ ga_str(ga_attr_value) ~ ', ' ~ ga_str(ga_attr_value) ~ ')') %}
{% else %}
{% set _ = ga_res_statements.append(
     '`set(attributes[' ~ (attr_key | tojson) ~ '], ' ~ (ga_attr_value | tojson) ~ ')`') %}
{% endif %}
{% endfor %}
otelcol.processor.transform "decdn_identity" {
  // Fail loud rather than silently shipping unlabelled telemetry.
  error_mode = "propagate"
{% for signal in ["trace", "metric", "log"] %}

  {{ signal }}_statements {
    context = "resource"
    statements = [
{% for statement in ga_res_statements %}
      {{ statement }},
{% endfor %}
    ]
  }
{% endfor %}

  output {
    traces  = [otelcol.processor.batch.decdn.input]
    logs    = [otelcol.processor.batch.decdn.input]
    metrics = [otelcol.processor.batch.decdn.input]
  }
}

{# Renders the operator-facing 0..1 keep-ratio as the component's percentage.
   Parent-based decisions must be made by the emitting SDK. #}
otelcol.processor.probabilistic_sampler "traces" {
  sampling_percentage = {{ grafana_alloy_trace_sampling_ratio | float * 100 }}

  output {
    traces = [otelcol.processor.transform.decdn_identity.input]
  }
}

otelcol.processor.batch "decdn" {
  send_batch_size     = {{ grafana_alloy_batch_send_size }}
  send_batch_max_size = {{ grafana_alloy_batch_max_size }}
  timeout             = {{ grafana_alloy_batch_timeout | to_json }}

  output {
    traces  = [otelcol.exporter.otlphttp.cloud.input]
    logs    = [otelcol.exporter.otlphttp.cloud.input]
    metrics = [otelcol.exporter.otlphttp.cloud.input]
  }
}

{# `sending_queue` and `retry_on_failure` are blocks of the EXPORTER, siblings of
   `client` — nesting them inside `client` is rejected at config load. #}
otelcol.exporter.otlphttp "cloud" {
  client {
    endpoint = {{ ga_endpoint(grafana_alloy_otlp_endpoint, 'GC_OTLP_ENDPOINT') }}
    auth     = otelcol.auth.basic.cloud.handler
  }

  sending_queue {
    queue_size = {{ grafana_alloy_queue_size }}
  }

  retry_on_failure {
    initial_interval = {{ grafana_alloy_retry_initial_interval | to_json }}
    max_elapsed_time = {{ grafana_alloy_retry_max_elapsed_time | to_json }}
  }
}

otelcol.auth.basic "cloud" {
  username = {{ ga_otlp_username() }}
  password = sys.env("GC_API_TOKEN")
}
