{% if ga_compose %}
{{ ga_compose_targets('iroh_dns_server', iroh_dns_server_metrics_bind | default('127.0.0.1') ~ ':' ~ iroh_dns_server_metrics_port | default(9117), grafana_alloy_iroh_dns_server_job, _ga_compose_profiles.iroh_dns_server) }}
