{% if ga_compose %}
{{ ga_compose_targets('iroh_relay', iroh_relay_metrics_bind | default('127.0.0.1') ~ ':' ~ iroh_relay_metrics_port | default(9092), grafana_alloy_iroh_relay_job, _ga_compose_profiles.iroh_relay) }}
