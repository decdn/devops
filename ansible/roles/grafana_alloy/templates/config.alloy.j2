{% if ga_compose %}
{{ ga_compose_targets('sponsord', sponsord_bind_address | default('127.0.0.1') ~ ':' ~ sponsord_port | default(8090), grafana_alloy_sponsord_job, _ga_compose_profiles.sponsord) }}
prometheus.scrape "sponsord" {
