# Template for /etc/grafana-alloy.env (root-owned 0600).
#
# Provision it ON THE TARGET HOST — this file holds your Grafana Cloud API token
# and must never be committed or carried through inventory:
#
#   umask 077
#   sudo install -m 600 -o root -g root grafana-alloy.env /etc/grafana-alloy.env
#
# MINIMUM CONTENT for a NEW host: the token, and nothing else. Every other value
# below is NON-secret and can be set once in inventory (group_vars) instead of
# being re-typed on every host — see the grafana_alloy_* variables named in each
# comment. A key is only required here when its inventory variable is empty.
#
# UPGRADING an existing host: journald shipping is on by default, so GC_LOKI_URL
# and GC_LOKI_USERNAME become required unless you set grafana_alloy_loki_url /
# grafana_alloy_loki_username in inventory, or turn logs off with
# grafana_alloy_logs_enabled: false. Preflight names the missing key and the
# variable that would satisfy it instead.
#
# Values come from your Grafana Cloud org: Home -> Stacks -> your stack, then the
# "Details/Send Metrics|Logs|Traces" pages show each endpoint plus its numeric
# instance ID. The role greps shapes only; it never reads values back onto the
# control machine.

# REQUIRED, always. An access-policy token with metrics:write + logs:write +
# traces:write scope for this stack. This is the one value with no inventory
# variable, deliberately: the rendered /etc/alloy/config.alloy is world-readable.
GC_API_TOKEN=glc_example_token_replace_me

# --- Optional: only needed if the matching inventory variable is left empty ----

# grafana_alloy_prom_url
#GC_PROM_REMOTE_WRITE_URL=https://prometheus-prod-XX-REGION.grafana.net/api/prom/push
# grafana_alloy_prom_username — the numeric Prometheus instance ID
#GC_PROM_USERNAME=1234567

# grafana_alloy_otlp_endpoint
#GC_OTLP_ENDPOINT=https://otlp-gateway-prod-XX.grafana.net/otlp

# Logs (grafana_alloy_logs_enabled, on by default). NOTE the Loki instance ID is
# a DIFFERENT number from the Prometheus one above; the token is shared.
# grafana_alloy_loki_url
#GC_LOKI_URL=https://logs-prod-XX.grafana.net/loki/api/v1/push
# grafana_alloy_loki_username — the numeric Loki instance ID
#GC_LOKI_USERNAME=7654321
