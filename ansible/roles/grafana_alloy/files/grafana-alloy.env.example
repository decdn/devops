# Template for /etc/decdn/grafana-alloy.env (root-owned 0600).
#
# Provision it ON THE TARGET HOST — these values are your Grafana Cloud
# credentials and must never be committed or carried through inventory:
#
#   umask 077
#   sudo install -m 600 -o root -g root grafana-alloy.env /etc/decdn/grafana-alloy.env
#
# Values come from your Grafana Cloud org: observe -> Application Observability ->
# "Instructions"/details page shows the exact remote-write URL, OTLP endpoint,
# instance id ("user") and API token. The role greps shapes only; it never reads
# values back onto the control machine.

GC_PROM_REMOTE_WRITE_URL=https://prometheus-prod-XX.grafana.net/api/prom/push
GC_OTLP_ENDPOINT=https://otlp-gateway-prod-XX.grafana.net/otlp
GC_PROM_USERNAME=1234567
# glc_... application token with write scope for this stack
GC_API_TOKEN=glc_example_token_replace_me
