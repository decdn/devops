# MANAGED BY the iroh_relay role — do not edit by hand.
#
# iroh-relay for {{ iroh_relay_hostname }}: the fallback path for iroh peers that
# cannot hole-punch, and (on udp/{{ _iroh_relay_ports.quic }}) QUIC address discovery.
# Public by design: it binds tcp/{{ _iroh_relay_ports.http }}, tcp/{{ _iroh_relay_ports.https }}{{ (' and udp/' ~ _iroh_relay_ports.quic) if iroh_relay_enable_quic_addr_discovery | bool else '' }}
# on {{ iroh_relay_bind_address }} and terminates its own TLS (Let's Encrypt);
# metrics stay on {{ iroh_relay_metrics_bind }}:{{ iroh_relay_metrics_port }}. The operator provisions no
# secret: the ACME account key and the TLS key are generated by the relay itself,
# in its 0700 state directory, and are its only private files.
[Unit]
Description=iroh-relay: the iroh relay server for deCDN peers
Documentation=https://github.com/n0-computer/iroh
After=network-online.target
Wants=network-online.target
# Without its config iroh-relay silently runs on built-in defaults (metrics on a
# public port, no TLS). Assert, not Condition: a missing file fails the start
# loudly instead of skipping it.
AssertPathExists={{ iroh_relay_config_file }}
AssertFileNotEmpty={{ iroh_relay_config_file }}

[Service]
Type=simple
ExecStart={{ iroh_relay_bin }} --config-path {{ iroh_relay_config_file }}
# iroh-relay logs only errors without RUST_LOG. Plain text into journald, without
# ANSI colour codes.
Environment="RUST_LOG={{ iroh_relay_log_level }}"
Environment=NO_COLOR=1
WorkingDirectory={{ _iroh_relay_state_dir }}

# It shuts down gracefully on SIGINT only (SIGTERM would kill it outright).
KillSignal=SIGINT
TimeoutStopSec=30
Restart=on-failure
RestartSec=5
LimitNOFILE={{ iroh_relay_limit_nofile }}

# --- Hardening -------------------------------------------------------------
DynamicUser=true
# The ACME account key and certificates survive restarts here (a fresh account
# per restart would run into Let's Encrypt's rate limits).
StateDirectory={{ _iroh_relay_state_dir | basename }} {{ _iroh_relay_state_dir | basename }}/{{ _iroh_relay_cert_dir | basename }}
StateDirectoryMode=0700
# The one privilege it keeps: binding ports below 1024.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
# AF_INET/AF_INET6 for the listeners and ACME; AF_UNIX + AF_NETLINK for the libc
# resolver.
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
UMask=0077

[Install]
WantedBy=multi-user.target
