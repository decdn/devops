# /etc/sponsord/secret.env — sponsord's secret environment file.
#
# Provision this ON THE TARGET HOST, as root, and leave sponsord_rpc_url empty in
# inventory: the role then never reads this file, it only enforces 0600 root and
# checks that a SPONSORD_RPC_URL line exists. systemd reads it before starting the
# service.
#
#   umask 077                                     # never briefly world-readable
#   sudo mkdir -p /etc/sponsord
#   sudo tee /etc/sponsord/secret.env >/dev/null  # then paste the line, Ctrl-D
#   sudo chmod 600 /etc/sponsord/secret.env       # sudo may apply its own umask
#
# After editing it, re-run the playbook (the role notices and restarts sponsord)
# or `sudo systemctl restart sponsord`.
#
# FORMAT: systemd's EnvironmentFile parser, not a shell. One KEY=value per line, no
# `export`, no expansion. A line it cannot parse is SKIPPED with only a journal
# warning, so single-quote a value containing a space, quote, backslash or `$`.

SPONSORD_RPC_URL='https://arb-sepolia.example-provider.invalid/v2/<api-key>'
