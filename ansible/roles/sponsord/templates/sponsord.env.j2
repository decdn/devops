# MANAGED BY the sponsord role — do not edit by hand. NO secrets: the RPC URL is in
# {{ sponsord_secret_env_file }}; the API token, treasury keystore and password
# reach the daemon as systemd credentials (see sponsord.service).
SPONSORD_BIND={{ sponsord_bind_address }}:{{ sponsord_port }}
SPONSORD_CHAIN_ID={{ sponsord_chain_id }}
SPONSORD_PAYMENT_POOL_ADDR={{ sponsord_payment_pool_address }}
SPONSORD_POOL_ID={{ sponsord_pool_id }}
{% for name, value in [
     ('SPONSORD_MAX_SPENDING_CAP_MICRO_USDC', sponsord_max_spending_cap_micro_usdc),
     ('SPONSORD_MAX_TTL_SECS', sponsord_max_ttl_secs),
     ('SPONSORD_POOL_LOW_WATER_MICRO_USDC', sponsord_pool_low_water_micro_usdc),
     ('SPONSORD_POOL_REFILL_MICRO_USDC', sponsord_pool_refill_micro_usdc),
     ('SPONSORD_POOL_WATCH_INTERVAL_SECS', sponsord_pool_watch_interval_secs),
     ('RUST_LOG', sponsord_log_level),
   ] if value | string | length > 0 %}
{{ name }}={{ value }}
{% endfor %}
