# MANAGED BY the iroh_dns_server role — do not edit by hand.
#
# iroh-dns-server's configuration (iroh-dns-server/src/config.rs, Config).
# iroh-dns-server ignores keys it does not know, so every key the role relies on is
# written out, upstream defaults included.

# The record store (signed-packets-1.db) and cert_cache/ (ACME account + certificates).
data_dir = {{ _iroh_dns_server_state_dir | tojson }}
# PUT /pkarr, per client address.
pkarr_put_rate_limit = {{ iroh_dns_server_pkarr_put_rate_limit | tojson }}

# Plain http, loopback only: the readiness gate's /healthz.
[http]
port = {{ iroh_dns_server_health_port | int }}
bind_addr = "127.0.0.1"

# The public pkarr relay (PUT/GET /pkarr/<z32>) and DNS-over-HTTPS (/dns-query).
[https]
port = {{ _iroh_dns_server_ports.https }}
bind_addr = {{ iroh_dns_server_https_bind_address | tojson }}
domains = [{{ iroh_dns_server_hostname | tojson }}]
cert_mode = "lets_encrypt"
letsencrypt_contact = {{ iroh_dns_server_acme_contact | tojson }}
letsencrypt_prod = {{ (not (iroh_dns_server_acme_staging | bool)) | lower }}

# The public DNS server, udp and tcp on the same address.
[dns]
port = {{ _iroh_dns_server_ports.dns }}
bind_addr = {{ iroh_dns_server_dns_bind_address | tojson }}
# Fully qualified: in 1.3.0 an origin without its trailing dot answers SOA but not
# the rr_a/rr_aaaa/rr_ns records at its apex. "." is always last: the static zone
# is rooted there and the server refuses to start without an SOA for it.
origins = {{ _iroh_dns_server_effective_origins | tojson }}
default_soa = {{ iroh_dns_server_default_soa | tojson }}
default_ttl = {{ iroh_dns_server_default_ttl | int }}
{% if _iroh_dns_server_effective_rr_a | length > 0 %}
rr_a = {{ _iroh_dns_server_effective_rr_a | tojson }}
{% endif %}
{% if iroh_dns_server_rr_aaaa | length > 0 %}
rr_aaaa = {{ iroh_dns_server_rr_aaaa | tojson }}
{% endif %}
{% if iroh_dns_server_rr_ns | length > 0 %}
rr_ns = {{ iroh_dns_server_rr_ns | tojson }}
{% endif %}

# Loopback only (upstream's default too, pinned here).
[metrics]
disabled = false
bind_addr = {{ (iroh_dns_server_metrics_bind ~ ':' ~ iroh_dns_server_metrics_port) | tojson }}

[mainline]
enabled = {{ iroh_dns_server_mainline_enabled | bool | lower }}
{% if iroh_dns_server_mainline_bootstrap | length > 0 %}
bootstrap = {{ iroh_dns_server_mainline_bootstrap | list | tojson }}
{% endif %}

# Upstream's defaults (src/store/signed_packets.rs): a record a node has not
# republished for 7 days is dropped.
[zone_store]
max_batch_size = 65536
max_batch_time = "1s"
eviction = "7days"
eviction_interval = "10s"
