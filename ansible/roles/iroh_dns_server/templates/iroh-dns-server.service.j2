# MANAGED BY the iroh_dns_server role — do not edit by hand.
#
# iroh-dns-server for {{ iroh_dns_server_hostname }}: the pkarr relay deCDN nodes
# publish their address records to, and the DNS server peers resolve them through.
# Public by design: it binds tcp/{{ _iroh_dns_server_ports.https }} on {{ iroh_dns_server_https_bind_address }}
# and udp+tcp/{{ _iroh_dns_server_ports.dns }} on {{ iroh_dns_server_dns_bind_address }}, and terminates its own TLS (Let's
# Encrypt); metrics stay on {{ iroh_dns_server_metrics_bind }}:{{ iroh_dns_server_metrics_port }} and the health listener on
# 127.0.0.1:{{ iroh_dns_server_health_port }}. The operator provisions no secret: the ACME account key and
# the TLS key are generated by the server itself, in its 0700 state directory.
[Unit]
Description=iroh-dns-server: the pkarr relay and DNS server for deCDN node discovery
Documentation=https://github.com/n0-computer/iroh
After=network-online.target
Wants=network-online.target
# Assert, not Condition: a missing or emptied config fails the start loudly
# instead of skipping it.
AssertPathExists={{ iroh_dns_server_config_file }}
AssertFileNotEmpty={{ iroh_dns_server_config_file }}

[Service]
Type=simple
ExecStart={{ iroh_dns_server_bin }} --config {{ iroh_dns_server_config_file }}
# iroh-dns-server logs only errors without RUST_LOG. Plain text into journald,
# without ANSI colour codes.
Environment="RUST_LOG={{ iroh_dns_server_log_level }}"
Environment=NO_COLOR=1
WorkingDirectory={{ _iroh_dns_server_state_dir }}

# It shuts down gracefully on SIGINT only (SIGTERM would kill it outright, losing
# up to a second of record writes).
KillSignal=SIGINT
TimeoutStopSec=30
Restart=on-failure
RestartSec=5
LimitNOFILE={{ iroh_dns_server_limit_nofile }}

# --- Hardening -------------------------------------------------------------
DynamicUser=true
# The record store, the ACME account key and certificates survive restarts here
# (a fresh account per restart would run into Let's Encrypt's rate limits).
StateDirectory={{ _iroh_dns_server_state_dir | basename }}
StateDirectoryMode=0700
# The one privilege it keeps: binding ports below 1024.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
# AF_INET/AF_INET6 for the listeners, ACME (and the mainline DHT, when on);
# AF_UNIX + AF_NETLINK for the libc resolver.
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
UMask=0077

[Install]
WantedBy=multi-user.target
