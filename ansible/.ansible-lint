---
# Both roles carry deliberately short var names, so the no-role-prefix rule is
# skipped project-wide (removing the skip surfaces ~60 violations):
#   - decdn_node uses a `decdn_` prefix, not the rule-expected `decdn_node_`
#     (decdn_rpc_url, decdn_bind_port, decdn_user, …) — the bulk of the skip.
#   - baseline surfaces a global knob in group_vars (ssh_allow_cidrs).
# Conventional names read better for a public ops repo than role-prefixed ones;
# everything else is held to the 'production' profile.
skip_list:
  - var-naming[no-role-prefix]

# build/ is the generated collection staging tree (`make build`). galaxy/ holds the
# `decdn.node` and `decdn.publisher` collection overlays (nested galaxy.yml +
# manifests) — they are built and validated separately by galaxy-importer (the
# `galaxy-build` CI job), and their pre-1.0 versions would otherwise trip
# galaxy[version-incrementing] here. Neither is part of the deploy project's lint
# scope.
exclude_paths:
  - build/
  - galaxy/
  # Imports the decdn.node collection's playbooks by FQCN, which exist only once the
  # scenario's prepare has built and installed the collection, so ansible-lint's
  # syntax check cannot load it. Of the playbooks it imports, node.yml is linted
  # here; the node-only backup.yml and decommission.yml live under the excluded
  # galaxy/, linted by galaxy-importer in the build and kept equal to playbooks/'s
  # node plays by make test-scripts.
  - molecule/collection/converge.yml

# Task files a molecule scenario includes (ansible-lint would otherwise read them as
# playbooks, and a `tasks/` directory would make the scenario look like a role).
kinds:
  - tasks: "**/molecule/*/includes/*.yml"
