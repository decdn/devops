# Installs to: /etc/systemd/system/cloudflared.service
#
# Cloudflare Tunnel that publishes https://rpc-dev.decdn.org. The tunnel connects
# OUTBOUND from this host to Cloudflare's edge, so no inbound port is opened.
# Traffic path: Internet -> Cloudflare edge (TLS) -> this tunnel -> Caddy
# (127.0.0.1:8080, basic-auth) -> anvil (127.0.0.1:8545).
#
# This unit is installed but NOT started by bin/install.sh, because it needs the
# tunnel credentials you create manually (`cloudflared tunnel login` +
# `cloudflared tunnel create`). See the service README "Cloudflare: manual steps".

[Unit]
Description=Cloudflare Tunnel for rpc-dev.decdn.org (-> Caddy -> anvil)
Documentation=https://github.com/decdn/decdn-devops
After=network-online.target caddy.service
Wants=network-online.target caddy.service

[Service]
Type=simple
User=cloudflared
Group=cloudflared

# Reads /etc/cloudflared/config.yml (copied from config.yml.example, with your
# tunnel id filled in) and the credentials JSON it references.
ExecStart=/usr/bin/cloudflared --no-autoupdate --config /etc/cloudflared/config.yml tunnel run
Restart=on-failure
RestartSec=5

# --- Hardening -------------------------------------------------------------
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadOnlyPaths=/etc/cloudflared
RestrictAddressFamilies=AF_INET AF_INET6
RestrictNamespaces=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
