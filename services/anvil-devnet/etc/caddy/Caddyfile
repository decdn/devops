# Installs to: /etc/caddy/Caddyfile  (replaces the stock one from the caddy package)
#
# Caddy sits behind the Cloudflare Tunnel and in front of anvil. Its only job is
# per-dev HTTP basic auth + reverse proxy to the local anvil RPC. TLS is handled
# at the Cloudflare edge, so Caddy serves plain HTTP on loopback only.

{
	# Cloudflare terminates TLS at the edge and cloudflared reaches us locally, so
	# Caddy must NOT try to provision its own certificates.
	auto_https off
	# No admin API surface needed.
	admin off
}

# Loopback-only listener. The sole public path is:
#   Cloudflare edge -> cloudflared tunnel -> this listener.
# `bind 127.0.0.1` is defense-in-depth so the port can never answer on a public
# interface even if the firewall is misconfigured.
:8080 {
	bind 127.0.0.1

	# Per-dev HTTP basic auth. Caddy 2.8+ uses `basic_auth` (the old `basicauth`
	# name is deprecated). Credentials are NOT in this repo: the block below is
	# generated on the host into /etc/caddy/rpc-dev.basicauth by
	# bin/caddy-add-user.sh, which runs `caddy hash-password` (bcrypt) per user.
	import /etc/caddy/rpc-dev.basicauth

	# Forward authenticated requests to the local anvil JSON-RPC.
	reverse_proxy 127.0.0.1:8545

	# Access logging to the journal (auditing who hit the RPC).
	log
}
