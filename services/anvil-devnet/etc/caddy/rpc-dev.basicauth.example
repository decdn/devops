# Installs to: /etc/caddy/rpc-dev.basicauth   (GENERATED — do not commit the real one)
#
# This file is imported by /etc/caddy/Caddyfile. It is produced on the host by
# bin/bootstrap.sh (initial `dev` user) and bin/caddy-add-user.sh (more users),
# both of which run `caddy hash-password` to bcrypt each password. The example
# below shows the exact shape Caddy expects — the $2a$… value is a bcrypt hash,
# never a plaintext password.

basic_auth {
	dev $2a$14$EXAMPLEEXAMPLEEXAMPLEEXAMPLEEXAMPLEEXAMPLEEXAMPLEEXAMPLEEX
}
