      "title": "Pool could not pay, 24h",
      "description": "Requests answered 503 because the gateway's pool cannot pay (decdn_gateway_pull_failures_funding_total). Anything above zero: fund the wallet (USDC, and ETH for gas).",
      "type": "stat",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "increase(decdn_gateway_pull_failures_funding_total{job=\"decdn-gateway\", instance=~\"$instance\"}[1d])",
          "refId": "A",
          "legendFormat": "{{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
