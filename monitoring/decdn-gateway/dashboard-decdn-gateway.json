      },
      "title": "Requests served, 24h",
      "description": "Requests answered with success or a redirect in the last 24 hours (decdn_gateway_requests_ok_total).",
      "type": "stat",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "increase(decdn_gateway_requests_ok_total{job=\"decdn-gateway\", instance=~\"$instance\"}[1d])",
          "refId": "A",
          "legendFormat": "{{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
