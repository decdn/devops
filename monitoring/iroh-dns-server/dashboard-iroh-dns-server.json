          "expr": "increase(dns_server_pkarr_publish_update_total{job=\"iroh-dns-server\", instance=~\"$instance\"}[1d]) + increase(dns_server_pkarr_publish_noop_total{job=\"iroh-dns-server\", instance=~\"$instance\"}[1d])",
          "refId": "A",
          "legendFormat": "{{instance}}"
