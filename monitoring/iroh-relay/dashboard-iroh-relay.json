      "title": "Relayed bandwidth",
      "description": "relayserver_bytes_recv_total (from clients) and relayserver_bytes_sent_total (to clients), in bits per second.",
      "type": "timeseries",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "rate(relayserver_bytes_recv_total{job=\"iroh-relay\", instance=~\"$instance\"}[$__rate_interval]) * 8",
          "refId": "A",
          "legendFormat": "in {{instance}}"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "rate(relayserver_bytes_sent_total{job=\"iroh-relay\", instance=~\"$instance\"}[$__rate_interval]) * 8",
          "refId": "B",
          "legendFormat": "out {{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 1,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "group": "A",
              "mode": "none"
            }
          },
          "unit": "bps",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
