          "refId": "B",
          "legendFormat": "relayed {{instance}}"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "rate(relayserver_send_packets_dropped_total{job=\"iroh-relay\", instance=~\"$instance\"}[$__rate_interval])",
          "refId": "C",
          "legendFormat": "dropped {{instance}}"
        }
