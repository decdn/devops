// GENERATED from ansible/roles/grafana_alloy/templates/config.alloy.j2 by
// scripts/render-compose-alloy.sh — do not edit by hand: change the template and
// regenerate (`make test-scripts` fails while this file differs from a fresh
// render). compose/compose.yaml's `alloy` service runs it (compose/README.md).
//
// Alloy's configuration syntax only understands `//` and `/* */` comments — a
// `#` is an illegal character that aborts the parse, so every comment in this
// file (and everything the Jinja layer emits) must stay `//`.
//
// Pipeline: scrape the node's /metrics and push it to Grafana Cloud Prometheus;
// scrape the MACHINE (Alloy's in-process node_exporter) and Alloy itself; ship
// journald to Grafana Cloud Loki; receive OTLP traces (plus any logs/metrics
// pushed over localhost) on gRPC 4317 / HTTP 4318 bound to loopback only; stamp
// resource identity on everything, probabilistically sample traces, batch, then
// export via OTLP/HTTP.
//
// Secrets are NOT literals here: every credential is read at config-load time
// with the `sys.env` stdlib function from the root-owned 0600 environment file
// Compose hands the container (env_file ALLOY_ENV_FILE, /etc/grafana-alloy.env
// by default: the same file the Ansible role's unit reads; template:
// compose/grafana-alloy.env.example). Alloy has no `--config.expand-env` flag —
// `${VAR}` inside a string is a literal, so `sys.env("VAR")` is the only working
// indirection.
//
// The host's identity (ALLOY_INSTANCE_ID, ALLOY_REGION,
// ALLOY_DEPLOYMENT_ENVIRONMENT) and the active profiles (DECDN_COMPOSE_PROFILES)
// come from compose.yaml's `environment:`, which reads them from .env.



// Scraped only while COMPOSE_PROFILES starts it (node or origin).
discovery.relabel "decdn_node_targets" {
  targets = [
    { "__address__"      = "127.0.0.1:9090",
      "instance"         = sys.env("ALLOY_INSTANCE_ID"),
      "job"              = "decdn-node",
      "__decdn_profiles" = string.format(",%s,", sys.env("DECDN_COMPOSE_PROFILES")) },
  ]

  rule {
    source_labels = ["__decdn_profiles"]
    regex         = `.*,\s*(?:node|origin|\*)\s*,.*`
    action        = "keep"
  }
}

prometheus.scrape "decdn_node" {
  targets         = discovery.relabel.decdn_node_targets.output
  forward_to      = [prometheus.relabel.decdn_identity.receiver]
  scrape_interval = "30s"
}

prometheus.relabel "decdn_identity" {
  forward_to = [prometheus.remote_write.cloud.receiver]

  rule {
    target_label = "service_name"
    replacement  = "decdn-node"
  }

  rule {
    target_label = "service_namespace"
    replacement  = "decdn"
  }

  rule {
    target_label = "service_instance_id"
    replacement  = sys.env("ALLOY_INSTANCE_ID")
  }

  rule {
    target_label = "deployment_environment"
    replacement  = sys.env("ALLOY_DEPLOYMENT_ENVIRONMENT")
  }

  rule {
    target_label = "region"
    replacement  = sys.env("ALLOY_REGION")
  }
}

