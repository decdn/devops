# Template for /etc/decdn-gateway/gateway.env (root:root 0600). Docker reads it as
# root before starting the container, so it never needs to be readable by the
# decdn-gateway account. One KEY=value per line, no `export`. Compose expands `$VAR`
# in unquoted and double-quoted values, so single-quote a value containing `$`.
#
# The RPC endpoint the gateway pays through. It may embed a provider API key, which
# is why it lives here: /etc/decdn-gateway/gateway.toml reads it as
# rpc_url = "${DECDN_GATEWAY_RPC_URL}".
DECDN_GATEWAY_RPC_URL=
# The gateway's log level (RUST_LOG): a level, or target=level pairs.
RUST_LOG=info
