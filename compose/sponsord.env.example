# Template for /etc/sponsord/sponsord.env (root:root 0644). No secrets: the RPC
# URL is in secret.env (which compose.yaml loads after this file, so it wins), and
# the API token, treasury keystore and password are files bind-mounted by
# compose.yaml, which also sets SPONSORD_BIND (loopback). Same format as the
# Ansible role's sponsord.env, so the file moves between paths.

# --- Required -------------------------------------------------------------------
# The chain and its PaymentPool contract. Take both from the deployment this repo
# mirrors, ansible/roles/sponsord/vars/main/networks.yml (generated from upstream's
# manifest; for arbitrum-sepolia: chain_id and payment_pool_address). Never guess.
SPONSORD_CHAIN_ID=
SPONSORD_PAYMENT_POOL_ADDR=
# The pool this treasury owns: 0x + 64 hex, printed by `decdn pool open` run once
# from the treasury wallet. The daemon checks at start that the treasury keystore's
# address owns it on-chain and exits if not.
SPONSORD_POOL_ID=

# --- Optional (the daemon's defaults shown) ---------------------------------------
# Economic decisions for the operator, not facts this repo carries.
# Largest cap per capability, in micro-USDC ($5)
# SPONSORD_MAX_SPENDING_CAP_MICRO_USDC=5000000
# Longest TTL per capability, in seconds (48 h)
# SPONSORD_MAX_TTL_SECS=172800
# Top the pool up below this, in micro-USDC ($20)
# SPONSORD_POOL_LOW_WATER_MICRO_USDC=20000000
# Each top-up adds this, in micro-USDC ($100)
# SPONSORD_POOL_REFILL_MICRO_USDC=100000000
# How often the keeper checks the pool, in seconds
# SPONSORD_POOL_WATCH_INTERVAL_SECS=3600
# Unset logs errors only; info adds the listener and each top-up.
# RUST_LOG=info
