# Template for /etc/sponsord/sponsord-onramp.env (root:root 0644). No secrets, and
# nothing here may become one: everything in it is served to every user.
# compose.yaml sets the listener (loopback), the daemon URL, the public URL (from
# SPONSORD_ONRAMP_DOMAIN in .env) and the paths of the API token and Turnstile
# secret, and those win over this file.

# --- Required -------------------------------------------------------------------
# The public RPC endpoint end users' decdn reads the chain through. No API key, no
# credentials, no query string.
ONRAMP_RPC_URL=
# CapacityBond, for node discovery. Take it from the deployment this repo mirrors,
# ansible/roles/sponsord_onramp/vars/main/networks.yml (capacity_bond_address), on
# the same chain as sponsord. The chain id and PaymentPool come from the daemon.
ONRAMP_CAPACITY_BOND_ADDR=
# Optional, from the same file (slash_judge_address).
# ONRAMP_SLASH_JUDGE_ADDR=
# Cloudflare Turnstile: the widget's public sitekey. Its secret goes in
# /etc/sponsord/turnstile-secret.
ONRAMP_GATE=turnstile
ONRAMP_TURNSTILE_SITEKEY=
# The releases the installers install: a tag and the SHA-256 of that release's
# SHA256SUMS file, for decdn (vX.Y.Z) and for decdn-sponsored
# (decdn-sponsored-vX.Y.Z; both values are in its release notes).
ONRAMP_DECDN_RELEASE=
ONRAMP_DECDN_SUMS_SHA256=
ONRAMP_CLI_RELEASE=
ONRAMP_CLI_SUMS_SHA256=

# --- Client address ---------------------------------------------------------------
# The header the proxy puts the client address in; the onramp rate limits by it.
# Unset = the TCP peer, which behind any proxy is the proxy itself, so every user
# shares one limit. With the caddy profile, uncomment this line: Caddy replaces
# any X-Forwarded-For the client sent. With your own proxy, set it only if that
# proxy is the ONLY way in and overwrites the header (e.g. CF-Connecting-IP
# behind Cloudflare); otherwise clients pick their own address.
# ONRAMP_CLIENT_IP_HEADER=X-Forwarded-For

# --- Optional (defaults shown) ----------------------------------------------------
# Oldest decdn-sponsored accepted; older CLIs are told to re-run the installer.
# ONRAMP_MIN_CLI_VERSION=
# Requested per capability; unset takes the daemon's maximum
# ONRAMP_SPENDING_CAP_MICRO_USDC=
# ONRAMP_TTL_SECS=
# ONRAMP_BRAND_NAME=deCDN
# Your own gate page instead of the built-in one (placeholders: upstream
# docs/operator.md). Put it in /etc/sponsord/onramp-gate/, the directory
# compose.yaml mounts for it, and point here INSIDE that directory: the onramp
# serves whatever file this names to anyone, so never a path under /run/secrets.
# ONRAMP_GATE_TEMPLATE=/etc/sponsord/onramp-gate/gate.html
# POST /v1/fund and GET /v1/capability per address per minute; 0 turns a limit off
# ONRAMP_FUND_RATE_PER_MIN=10
# ONRAMP_POLL_RATE_PER_MIN=120
# ONRAMP_RELEASES_BASE=https://github.com/decdn
# Log level, info by default: a level or target=level pairs only. The release is
# built without tracing's env-filter, so a span or field filter makes it log nothing.
# RUST_LOG=info
