# Copy to .env beside compose.yaml. Nothing here is secret.

# Which services this host runs (compose.yaml's header): any of node, origin,
# sponsord, onramp (which also starts sponsord), relay, dns, gateway and alloy,
# comma-separated.
# Node operators:
#   node                  a deCDN cache node
# Publishers:
#   origin                an origin node (node.toml carries its origin backend)
#   onramp                the sponsor daemon and its public onramp, on loopback
#                         behind your own TLS proxy for SPONSORD_ONRAMP_DOMAIN
#   origin,onramp         both on one host
#   sponsord              the sponsor daemon only
#   relay                 a self-hosted iroh relay (on its own host: it wants
#                         tcp/80 and tcp/443, which your onramp or gateway proxy
#                         wants too)
#   dns                   a self-hosted iroh DNS server (on its own host too: not
#                         with relay, nor beside a proxy on tcp/443)
#   gateway               a public deCDN gateway on loopback, behind your own TLS
#                         proxy for <domain> and *.<domain>
# Any of them:
#   …,alloy               also ship this host's metrics and logs to Grafana Cloud
COMPOSE_PROFILES=node

# Every image is pinned by digest (compose.yaml builds REPO@DIGEST). Take a digest
# from the release's signed digest file (<image>-image-digest.txt; decdn v0.0.1's is
# plain image-digest.txt; verify its .asc against the maintainer keys in that
# repository's KEYS), not from whatever a tag points at today. The
# file holds REPO@DIGEST: copy the part after `@`. Override a REPO for a mirror or
# a local registry (README.md, "A local image"). Set only the ones your profiles
# use; an unset one fails only the service that needs it. The values below are the
# newest releases of the lines the Ansible roles pin: the roles follow the line,
# Compose names one release of it (README.md, the node's "Operate").

# --- node -----------------------------------------------------------------------
# decdn/decdn v0.3.1
DECDN_IMAGE_DIGEST=sha256:df8900be7140f58a135bf7487dc1342e70c49b01305a250a47df51f14cb5745e
# DECDN_IMAGE_REPO=ghcr.io/decdn/decdn-node

# uid/gid of the host's dedicated `decdn` system account, which owns /var/lib/decdn
# and can read /etc/decdn/keystore.password: `id -u decdn`, `id -g decdn`.
DECDN_UID=999
DECDN_GID=999

# Host path of the 0600 environment file holding DECDN_RPC_URL.
DECDN_ENV_FILE=/etc/decdn/decdn.env

# --- sponsord and onramp ----------------------------------------------------------
# From the same decdn/decdn release as the node's digest above: one release ships
# all three images (sponsord_version = decdn_node_version). Each from the release's
# signed sponsord-image-digest.txt / sponsord-onramp-image-digest.txt.
SPONSORD_IMAGE_DIGEST=sha256:73909acb22f87b53a06edd7d33ab946df721492a4648d61001c6cdd21c462169
# SPONSORD_IMAGE_REPO=ghcr.io/decdn/sponsord
SPONSORD_ONRAMP_IMAGE_DIGEST=sha256:f73f6aafb0f60f887945bbf3fc66e4b6b3c0b94b539793a8e2da3ead967ee826
# SPONSORD_ONRAMP_IMAGE_REPO=ghcr.io/decdn/sponsord-onramp

# uid/gid of the host's dedicated `sponsord` system account, which owns the
# credential files in /etc/sponsord: `id -u sponsord`, `id -g sponsord`. Both
# daemons run as it.
SPONSORD_UID=998
SPONSORD_GID=998

# Host paths of the environment files (README.md lists what goes in each).
SPONSORD_SECRET_ENV_FILE=/etc/sponsord/secret.env
SPONSORD_ENV_FILE=/etc/sponsord/sponsord.env
SPONSORD_ONRAMP_ENV_FILE=/etc/sponsord/sponsord-onramp.env

# The onramp's public host name: its public URL is https://<this>, which your own
# TLS proxy serves (README.md, "sponsord and its onramp"). Point its DNS at that proxy.
SPONSORD_ONRAMP_DOMAIN=onramp.example.org

# --- relay ------------------------------------------------------------------------
# compose.yaml pins n0's official iroh-relay image (the release the Ansible role
# pins) by digest; override both to change it. It runs as root holding
# NET_BIND_SERVICE only, so it needs no host account (README.md, An iroh relay).
# IROH_RELAY_IMAGE_REPO=docker.io/n0computer/iroh-relay
# IROH_RELAY_IMAGE_DIGEST=sha256:…

# --- dns --------------------------------------------------------------------------
# The same for n0's iroh-dns-server image (README.md, An iroh DNS server). With
# another digest, `decdn-compose health` no longer insists on the pinned version.
# IROH_DNS_SERVER_IMAGE_REPO=docker.io/n0computer/iroh-dns-server
# IROH_DNS_SERVER_IMAGE_DIGEST=sha256:…
# --- gateway ----------------------------------------------------------------------
# The decdn CLI from the node image above: set DECDN_IMAGE_DIGEST even on a host
# without a node.
# uid/gid of the host's dedicated `decdn-gateway` system account, which owns
# /var/lib/decdn-gateway (the wallet, the pool store, the pointers):
# `id -u decdn-gateway`, `id -g decdn-gateway`.
DECDN_GATEWAY_UID=995
DECDN_GATEWAY_GID=995
# The domain the gateway serves: its public URL is https://<this>. Point <domain>
# and *.<domain> at this host and terminate TLS for both in your proxy.
DECDN_GATEWAY_DOMAIN=gateway.example.org
# Bytes it delivers per UTC day from its pool, over every request (512MiB, 20GiB).
DECDN_GATEWAY_ALLOWANCE_BYTES_PER_DAY=1GiB
# Host path of the 0600 environment file holding DECDN_GATEWAY_RPC_URL.
DECDN_GATEWAY_ENV_FILE=/etc/decdn-gateway/gateway.env

# --- alloy (Grafana Cloud) ----------------------------------------------------------
# uid/gid of the host's dedicated `alloy` system account, which owns /var/lib/alloy:
# `id -u alloy`, `id -g alloy`. ALLOY_JOURNAL_GID is the host's systemd-journal
# group (`getent group systemd-journal`), which lets it read the journal.
ALLOY_UID=996
ALLOY_GID=996
ALLOY_JOURNAL_GID=101

# Host path of the 0600 file holding the Grafana Cloud token and endpoints (GC_*):
# the same file the Ansible grafana_alloy role reads.
ALLOY_ENV_FILE=/etc/grafana-alloy.env

# Stamped on every series and log line, so keep them low-cardinality: letters,
# digits, . _ / -, at most 63. `init alloy` sets the instance to the host name and
# the region to the node's (node.toml). An empty region or environment leaves its
# label out; the instance is required (`check` refuses it empty).
ALLOY_INSTANCE_ID=
ALLOY_REGION=
ALLOY_DEPLOYMENT_ENVIRONMENT=production
# compose.yaml pins the official image by digest; override both to change it.
# ALLOY_IMAGE_REPO=docker.io/grafana/alloy
# ALLOY_IMAGE_DIGEST=sha256:…
