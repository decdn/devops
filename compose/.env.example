# Copy to .env beside compose.yaml. Nothing here is secret.

# Which services this host runs (compose.yaml's header): any of node, origin,
# sponsord, onramp (which also starts sponsord) and caddy, comma-separated.
# Node operators:
#   node                  a deCDN cache node
# Publishers:
#   origin                an origin node (node.toml carries its origin backend)
#   onramp,caddy          the sponsor daemon, its public onramp and TLS in front
#   origin,onramp,caddy   all of it on one host
#   sponsord              the sponsor daemon only
#   relay                 a self-hosted iroh relay (on its own host: not with
#                         onramp or caddy, which want the same ports)
#   dns                   a self-hosted iroh DNS server (on its own host too: not
#                         with relay, onramp or caddy)
COMPOSE_PROFILES=node

# Every image is pinned by digest (compose.yaml builds REPO@DIGEST). Take a digest
# from the release's signed digest file (<image>-image-digest.txt; decdn v0.0.1's is
# plain image-digest.txt; verify its .asc against the maintainer keys in that
# repository's KEYS), not from whatever a tag points at today. The
# file holds REPO@DIGEST: copy the part after `@`. Override a REPO for a mirror or
# a local registry (README.md, "A local image"). Set only the ones your profiles
# use; an unset one fails only the service that needs it. The values below are the
# releases the Ansible roles pin (README.md, the node's "Operate").

# --- node -----------------------------------------------------------------------
# decdn/decdn v0.0.2
DECDN_IMAGE_DIGEST=sha256:cb7f2915ffd2cc595e2d373169b4c8386c6877bd1de4d0f41e6846c6d178115c
# DECDN_IMAGE_REPO=ghcr.io/decdn/decdn-node

# uid/gid of the host's dedicated `decdn` system account, which owns /var/lib/decdn
# and can read /etc/decdn/keystore.password: `id -u decdn`, `id -g decdn`.
DECDN_UID=999
DECDN_GID=999

# Host path of the 0600 environment file holding DECDN_RPC_URL.
DECDN_ENV_FILE=/etc/decdn/decdn.env

# --- sponsord and onramp ----------------------------------------------------------
# decdn/sponsord v0.0.2, one release for both images
SPONSORD_IMAGE_DIGEST=sha256:bc71f5e608a939f38eae372934e5ec2c61ecfa67945cfa64c58504bea1aed66a
# SPONSORD_IMAGE_REPO=ghcr.io/decdn/sponsord
SPONSORD_ONRAMP_IMAGE_DIGEST=sha256:be80739ab98505ac46fb6009706f21fadfdf71d470287cad66f484889862552f
# SPONSORD_ONRAMP_IMAGE_REPO=ghcr.io/decdn/sponsord-onramp

# uid/gid of the host's dedicated `sponsord` system account, which owns the
# credential files in /etc/sponsord: `id -u sponsord`, `id -g sponsord`. Both
# daemons run as it.
SPONSORD_UID=998
SPONSORD_GID=998

# Host paths of the environment files (README.md lists what goes in each).
SPONSORD_SECRET_ENV_FILE=/etc/sponsord/secret.env
SPONSORD_ENV_FILE=/etc/sponsord/sponsord.env
SPONSORD_ONRAMP_ENV_FILE=/etc/sponsord/sponsord-onramp.env

# The onramp's public host name: its public URL is https://<this>, and the caddy
# profile requests the certificate for it. Point its DNS at this host.
SPONSORD_ONRAMP_DOMAIN=onramp.example.org

# --- caddy ------------------------------------------------------------------------
# uid/gid of the host's dedicated `caddy` system account, which owns /var/lib/caddy.
CADDY_UID=997
CADDY_GID=997
# compose.yaml pins the official image by digest; override both to change it.
# CADDY_IMAGE_REPO=docker.io/library/caddy
# CADDY_IMAGE_DIGEST=sha256:…

# --- relay ------------------------------------------------------------------------
# compose.yaml pins n0's official iroh-relay image (the release the Ansible role
# pins) by digest; override both to change it. It runs as root holding
# NET_BIND_SERVICE only, so it needs no host account (README.md, An iroh relay).
# IROH_RELAY_IMAGE_REPO=docker.io/n0computer/iroh-relay
# IROH_RELAY_IMAGE_DIGEST=sha256:…

# --- dns --------------------------------------------------------------------------
# The same for n0's iroh-dns-server image (README.md, An iroh DNS server). With
# another digest, `decdn-compose health` no longer insists on the pinned version.
# IROH_DNS_SERVER_IMAGE_REPO=docker.io/n0computer/iroh-dns-server
# IROH_DNS_SERVER_IMAGE_DIGEST=sha256:…
