# Template for /etc/grafana-alloy.env (root, 0600) on a Compose host: the Grafana
# Cloud token and endpoints the `alloy` profile's container reads
# (compose/README.md, "Grafana Cloud"). `decdn-compose init alloy` installs it;
# fill it in with `sudoedit /etc/grafana-alloy.env`. Never commit a filled-in copy.
#
# The same file, at the same path, as the Ansible grafana_alloy role's
# (ansible/roles/grafana_alloy/files/grafana-alloy.env.example), except that Compose
# has no inventory to take the non-secret values from: every key below is needed
# except GC_OTLP_USERNAME.
#
# Values come from your Grafana Cloud org: Home -> Stacks -> your stack, then the
# "Details/Send Metrics|Logs|Traces" pages show each endpoint plus its numeric
# instance ID. Each service has ITS OWN instance ID: copy each from the page that
# names it rather than reusing one value.

# An access-policy token with metrics:write, logs:write and traces:write for this
# stack. The only secret here.
GC_API_TOKEN=

# Metrics: the remote-write URL and the numeric Prometheus instance ID.
GC_PROM_REMOTE_WRITE_URL=
GC_PROM_USERNAME=

# Logs: the push URL and the numeric Loki instance ID (NOT the Prometheus one).
GC_LOKI_URL=
GC_LOKI_USERNAME=

# Traces: the OTLP gateway. Its username is the numeric STACK instance ID shown on
# the OTLP page; left empty, the Prometheus ID is used, which 401s traces on
# stacks where the two differ.
GC_OTLP_ENDPOINT=
GC_OTLP_USERNAME=
