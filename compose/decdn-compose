def file_problem(
    path: Path, uid: int | None, *, private: bool = True, nonempty: bool = True, what: str = ""
) -> str | None:
    hint = f" ({what})" if what else ""
    try:
        st = path.lstat()
    except FileNotFoundError:
        return f"{path} is missing{hint}"
    if not stat.S_ISREG(st.st_mode):
        return f"{path} is not a regular file"
    if uid is not None and st.st_uid != uid:
        return f"{path} is owned by uid {st.st_uid}, not {uid}"
    if private and st.st_mode & 0o077:
        return f"{path} is mode {stat.S_IMODE(st.st_mode):04o}: make it 0600"
    if nonempty and st.st_size == 0:
        return f"{path} is empty{hint}"
    return None


def env_problems(path: Path, values: Mapping[str, str], required: list[str], what: str) -> list[str]:
    if not path.exists():
        return []  # reported by file_problem
    return [f"{path}: set {k} ({what})" for k in required if not values.get(k)]


def problems(project: Project, files_only: bool = False) -> list[str]:
    out: list[str] = []
    env = project.env
    unknown = [p for p in project.profiles if p not in PROFILES]
    if unknown:
        out.append(f"COMPOSE_PROFILES names unknown profiles: {', '.join(unknown)}")
    if not project.profiles:
        out.append("COMPOSE_PROFILES in .env selects no service")
    svcs = project.services
    rendered = rendered_environments()

    def values(svc: str, path: Path) -> Mapping[str, str]:
        """What the service gets: Compose's render, else the file as parse_env reads it."""
        if svc in rendered:
            return rendered[svc]
        return parse_env(path) if path.exists() else {}

    seen: dict[str, int | None] = {}

    def uid_of(prefix: str, account: str) -> int | None:
        if prefix not in seen:
            seen[prefix] = _uid_of(prefix, account)
        return seen[prefix]

    def _uid_of(prefix: str, account: str) -> int | None:
        raw = env.get(f"{prefix}_UID", "")
        if not raw.isdigit() or not env.get(f"{prefix}_GID", "").isdigit():
            out.append(f".env: {prefix}_UID / {prefix}_GID are not set (`init` fills them)")
            return None
        try:
            real = pwd.getpwnam(account).pw_uid
        except KeyError:
            out.append(f"the {account} account does not exist (`decdn-compose init`)")
            return int(raw)
        if real != int(raw):
            out.append(f".env: {prefix}_UID={raw}, but `id -u {account}` is {real}")
        return int(raw)

    if "decdn-node" in svcs:
        uid = uid_of("DECDN", "decdn")
        for p in (NODE_PASSWORD, NODE_SECRET, NODE_KEYSTORE):
            out += filter(None, [file_problem(p, uid)])
        out += filter(None, [file_problem(NODE_TOML, None, private=False)])
        dec_env = project.env_file("DECDN_ENV_FILE")
        out += filter(None, [file_problem(dec_env, 0, nonempty=False)])
        if dec_env.exists() and not values("decdn-node", dec_env).get("DECDN_RPC_URL"):
            out.append(f"{dec_env}: set DECDN_RPC_URL, your RPC endpoint (sudoedit {dec_env})")
        if (
            "origin" in project.profiles
            and NODE_TOML.exists()
            and not re.search(r"(?m)^\[cache\.origin\]", NODE_TOML.read_text())
        ):
            out.append(f"{NODE_TOML} has no [cache.origin] table, but the origin profile is on")
        out += origin_dir_problems(env.get("DECDN_ORIGIN_DIR", ""))
    if "sponsord" in svcs:
        uid = uid_of("SPONSORD", "sponsord")
        out += filter(None, [file_problem(SD_TOKEN, uid)])
        out += filter(
            None,
            [
                file_problem(
                    SD_KEYSTORE, uid, what="the treasury wallet's eth keystore; or `init sponsord --generate-treasury`"
                )
            ],
        )
        out += filter(None, [file_problem(SD_PASSWORD, uid, what="its password")])
        secret_env = project.env_file("SPONSORD_SECRET_ENV_FILE")
        out += filter(None, [file_problem(secret_env, 0, nonempty=False)])
        out += env_problems(secret_env, values("sponsord", secret_env), ["SPONSORD_RPC_URL"], "the RPC endpoint")
        sd_env = project.env_file("SPONSORD_ENV_FILE")
        out += filter(None, [file_problem(sd_env, 0, private=False, nonempty=False)])
        out += env_problems(
            sd_env,
            values("sponsord", sd_env),
            ["SPONSORD_CHAIN_ID", "SPONSORD_PAYMENT_POOL_ADDR", "SPONSORD_POOL_ID"],
            "README.md, sponsord step 2",
        )
        if sd_env.exists() and "SPONSORD_RPC_URL" in parse_env(sd_env):
            out.append(f"{sd_env} is world-readable: move SPONSORD_RPC_URL to {secret_env}")
    if "sponsord-onramp" in svcs:
        out += filter(
            None, [file_problem(SD_TURNSTILE, uid_of("SPONSORD", "sponsord"), what="the Turnstile widget's secret key")]
        )
        on_env = project.env_file("SPONSORD_ONRAMP_ENV_FILE")
        out += filter(None, [file_problem(on_env, 0, private=False, nonempty=False)])
        onramp_values = values("sponsord-onramp", on_env)
        out += env_problems(
            on_env,
            onramp_values,
            ["ONRAMP_RPC_URL", "ONRAMP_CAPACITY_BOND_ADDR", "ONRAMP_TURNSTILE_SITEKEY"],
            "README.md, sponsord step 2",
        )
        rpc = onramp_values.get("ONRAMP_RPC_URL", "")
        # Served to every user: no credentials, no query (the role's preflight).
        if rpc and not re.fullmatch(r"https?://[^/?#@\s'\"`$\\{}]+(/[^?#\s'\"`$\\{}]*)?", rpc):
            out.append(
                f"{on_env}: ONRAMP_RPC_URL must be an http(s) URL with no userinfo, query or "
                "fragment: every user is served it"
            )
    if svcs & {"sponsord-onramp", "caddy"}:
        dom = env.get("SPONSORD_ONRAMP_DOMAIN", "")
        if not dom or dom == "onramp.example.org":
            out.append(".env: set SPONSORD_ONRAMP_DOMAIN, the onramp's public host name")
    if "caddy" in svcs:
        uid = uid_of("CADDY", "caddy")
        if not VAR_CADDY.is_dir():
            out.append(f"{VAR_CADDY} is missing (`init caddy`)")
        elif uid is not None and VAR_CADDY.stat().st_uid != uid:
            out.append(f"{VAR_CADDY} is not owned by the caddy account")
    out += conflicts(project.profiles)
    for svc, key, conf, var, problems_of in (
        ("iroh-relay", "IROH_RELAY_IMAGE_DIGEST", RELAY_TOML, VAR_RELAY, relay_problems),
        ("iroh-dns-server", "IROH_DNS_SERVER_IMAGE_DIGEST", DNS_TOML, VAR_DNS, dns_problems),
    ):
        if svc not in svcs:
            continue
        profile = "relay" if svc == "iroh-relay" else "dns"
        out += filter(None, [file_problem(conf, 0, private=False, what=f"`init {profile}`")])
        if conf.is_file():
            out += problems_of(conf)
        out += state_dir_problems(var, profile)
        digest = env.get(key)
        if digest is not None and not re.fullmatch(r"sha256:[0-9a-f]{64}", digest):
            out.append(f".env: {key} is set but not a sha256 digest (unset it for compose.yaml's pin)")
    if "alloy" in svcs:
        out += alloy_problems(project, uid_of("ALLOY", "alloy"), values("alloy", project.env_file("ALLOY_ENV_FILE")))
    if not files_only:
        for svc in sorted(svcs):
            key = {
                "decdn-node": "DECDN_IMAGE_DIGEST",
                "sponsord": "SPONSORD_IMAGE_DIGEST",
                "sponsord-onramp": "SPONSORD_ONRAMP_IMAGE_DIGEST",
            }.get(svc)
            if key and not re.fullmatch(r"sha256:[0-9a-f]{64}", env.get(key, "")):
                out.append(f".env: {key} is not a sha256 digest")
    return out


def alloy_problems(project: Project, uid: int | None, values: Mapping[str, str] | None = None) -> list[str]:
    """The alloy profile: its state directory, the journal it reads and the group
    that reads it, the Grafana Cloud env file (root, 0600, every key the Compose
    configuration reads), the identity it stamps, and the generated config.
    `values`: Alloy's environment as Compose renders it (problems()), else the env
    file as parse_env reads it."""
    out: list[str] = []
    env = project.env
    if not VAR_ALLOY.is_dir():
        out.append(f"{VAR_ALLOY} is missing (`init alloy`)")
    elif uid is not None and VAR_ALLOY.stat().st_uid != uid:
        out.append(f"{VAR_ALLOY} is not owned by the alloy account")
    try:
        journal_gid = grp.getgrnam("systemd-journal").gr_gid
    except KeyError:
        out.append("no systemd-journal group on this host: Alloy could not read the journal")
    else:
        if env.get("ALLOY_JOURNAL_GID") != str(journal_gid):
            out.append(
                f".env: ALLOY_JOURNAL_GID={env.get('ALLOY_JOURNAL_GID', '')!r}, but the systemd-journal "
                f"group is {journal_gid} (`init alloy` sets it)"
            )
    if not JOURNAL_DIR.is_dir():
        out.append(
            f"{JOURNAL_DIR} is missing: the journal is not persistent. Make it so "
            "(mkdir -p /var/log/journal && systemd-tmpfiles --create --prefix /var/log/journal && "
            "journalctl --flush), or drop the alloy profile"
        )
    if not MACHINE_ID.is_file():
        out.append(f"{MACHINE_ID} is missing")
    if not ALLOY_CONFIG.is_file():
        out.append(f"{ALLOY_CONFIG} is missing (scripts/render-compose-alloy.sh generates it)")
    env_path = project.env_file("ALLOY_ENV_FILE")
    out += filter(None, [file_problem(env_path, 0, what="the Grafana Cloud token and endpoints")])
    if values is None:
        values = parse_env(env_path) if env_path.exists() else {}
    out += env_problems(env_path, values, list(ALLOY_REQUIRED), f"sudoedit {env_path}; README.md, Grafana Cloud")
    if "replace_me" in values.get("GC_API_TOKEN", ""):
        out.append(f"{env_path}: GC_API_TOKEN is still the example value")
    if not env.get("ALLOY_INSTANCE_ID") or env["ALLOY_INSTANCE_ID"].startswith("unset-"):
        out.append(".env: set ALLOY_INSTANCE_ID, the host's name in Grafana Cloud (`init alloy` sets the host name)")
    for key in ALLOY_IDENTITY:
        value = env.get(key, "")
        if value and not IDENTITY_RE.fullmatch(value):
            out.append(f".env: {key}={value!r} is not 1-63 of letters, digits, . _ / - (a low-cardinality label)")
    return out


def origin_dir_problems(value: str) -> list[str]:
    """DECDN_ORIGIN_DIR: an existing absolute directory that neither is, sits
    inside nor contains one holding the host's secrets or state: the fs origin
    serves every file under it that the node's account can read, and that
    includes its own key in /var/lib/decdn (the lint cannot pin an operator's
    path)."""
    if not value:
        if not NO_ORIGIN.is_dir():
            return [f"{NO_ORIGIN} is missing (`decdn-compose init node` creates it)"]
        return []
    path = Path(value)
    if not path.is_absolute() or not path.is_dir():
        return [f".env: DECDN_ORIGIN_DIR={value} is not an existing absolute directory (an NFS mount not up?)"]
    real = path.resolve()
    # Both the protected paths and where they resolve to: /var/lib/decdn may be a
    # symlink onto a data disk, and Docker follows it when it mounts the state dir.
    protected = {Path(p) for p in NOT_ORIGIN} | {Path(p).resolve() for p in NOT_ORIGIN}
    if any(real == p or real in p.parents or p in real.parents for p in protected):
        return [f".env: DECDN_ORIGIN_DIR={value} resolves to {real}, which holds this host's secrets or state"]
    return []


def rendered_origin_problems(rendered: Mapping) -> list[str]:
    """origin_dir_problems for the directory Compose actually mounts as the fs
    origin, whatever .env, the shell or an override made of DECDN_ORIGIN_DIR."""
    node = (rendered.get("services") or {}).get("decdn-node") or {}
    for vol in node.get("volumes") or []:
        if vol.get("target") == ORIGIN_TARGET:
            source = str(vol.get("source") or "")
            return [] if source == str(NO_ORIGIN) else origin_dir_problems(source)
    return []


def state_dir_problems(path: Path, profile: str) -> list[str]:
    """An iroh service's state directory: root's, private (its ACME account key)."""
    try:
        st = path.lstat()
    except FileNotFoundError:
        return [f"{path} is missing (`init {profile}`)"]
    if not stat.S_ISDIR(st.st_mode):
        return [f"{path} is not a directory"]
    if st.st_uid != 0 or st.st_mode & 0o077:
        return [f"{path} must be root's, mode 0700 (it holds the ACME account key): chown root: and chmod 0700 it"]
    return []


def socket_addr(value: object) -> tuple[ipaddress.IPv4Address | ipaddress.IPv6Address, int] | None:
    """A Rust SocketAddr as iroh's configs write it: 1.2.3.4:80 or [::]:80."""
    if not isinstance(value, str):
        return None
    m = re.fullmatch(r"\[([0-9A-Fa-f:.]+)\]:(\d{1,5})|([0-9.]+):(\d{1,5})", value)
    if not m:
        return None
    try:
        addr = ipaddress.ip_address(m[1] or m[3])
    except ValueError:
        return None
    if isinstance(addr, ipaddress.IPv6Address) != bool(m[1]):
        return None
    return addr, int(m[2] or m[4])


def bindv6only() -> bool:
    try:
        return BINDV6ONLY.read_text().strip() == "1"
    except OSError:
        return False


def public_bind_problem(what: str, value: object, port: int) -> str | None:
    """A public listener: a fixed port on a wildcard or one of the host's own
    unicast addresses (the role parses its bind address the same way)."""
    sa = socket_addr(value)
    if sa is None:
        return f'{what} = {value!r} is not an address:port such as "[::]:{port}" or "0.0.0.0:{port}"'
    addr, got = sa
    if got != port:
        return f"{what} must use port {port}, not {got}"
    if addr.is_loopback or addr.is_link_local or addr.is_multicast:
        return f"{what} = {value!r}: a loopback, link-local or multicast address serves no peer"
    if isinstance(addr, ipaddress.IPv6Address) and addr.ipv4_mapped:
        return f"{what} = {value!r}: an IPv4-mapped address; write the IPv4 address itself"
    if addr == ipaddress.IPv6Address("::") and bindv6only():
        return (
            f"{what} = {value!r}: this host has net.ipv6.bindv6only=1, so [::] serves no IPv4 peer; "
            "use 0.0.0.0 or set the sysctl to 0"
        )
    return None


def load_toml(path: Path) -> tuple[dict, str | None]:
    try:
        return tomllib.loads(path.read_text()), None
    except (OSError, UnicodeDecodeError, tomllib.TOMLDecodeError) as e:
        return {}, f"{path} is not readable TOML: {e}"


def relay_problems(path: Path) -> list[str]:
    """What the relay would ignore, or run unsafely with: iroh-relay itself reports
    neither an unknown key nor most bad values until a peer trips over them."""
    cfg, err = load_toml(path)
    if err:
        return [err]
    out: list[str] = []
    where = f"{path}:"

    def unknown(section: str, table: object) -> None:
        if not isinstance(table, dict):
            out.append(f"{where} {section} is not a table")
            return
        extra = sorted(set(table) - RELAY_KEYS[section])
        if extra:
            out.append(f"{where} unknown key(s) in {section}: {', '.join(extra)} (iroh-relay 1.3.0 would ignore them)")

    unknown("the top level", cfg)
    tls = cfg.get("tls")
    if tls is None:
        out.append(f"{where} no [tls] table: the relay must get its certificate from Let's Encrypt")
        tls = {}
    else:
        unknown("[tls]", tls)
        tls = tls if isinstance(tls, dict) else {}
    limits = cfg.get("limits")
    if limits is not None:
        unknown("[limits]", limits)
        client = limits.get("client") if isinstance(limits, dict) else None
        if client is not None:
            unknown("[limits.client]", client)
            if isinstance(client, dict) and client.get("rx") is not None:
                unknown("[limits.client.rx]", client["rx"])

    if cfg.get("enable_relay") is not True:
        out.append(f"{where} enable_relay must be true")
    if cfg.get("enable_metrics") is not True:
        out.append(f"{where} enable_metrics must be true (`decdn-compose health` reads /metrics)")
    if cfg.get("metrics_bind_addr") != RELAY_METRICS:
        out.append(
            f'{where} metrics_bind_addr must be "{RELAY_METRICS}" (got {cfg.get("metrics_bind_addr")!r}): '
            "iroh-relay's default is public, metrics never are, and that is where the dashboards' "
            "scrape (and the alloy profile) reads them"
        )
    qad = cfg.get("enable_quic_addr_discovery", False)
    if not isinstance(qad, bool):
        out.append(f"{where} enable_quic_addr_discovery must be true or false")
    for key, table, port in (
        ("http_bind_addr", cfg, RELAY_FIXED_PORTS["http_bind_addr"]),
        ("https_bind_addr", tls, RELAY_FIXED_PORTS["https_bind_addr"]),
        ("quic_bind_addr", tls, RELAY_FIXED_PORTS["quic_bind_addr"]),
    ):
        if key == "quic_bind_addr" and qad is not True and key not in table:
            continue
        problem = public_bind_problem(key, table.get(key), port)
        if problem:
            out.append(f"{where} {problem}")

    if tls.get("cert_mode") != "LetsEncrypt":
        out.append(f'{where} [tls] cert_mode must be "LetsEncrypt" (got {tls.get("cert_mode")!r})')
    for key in ("manual_cert_path", "manual_key_path", "dangerous_http_only"):
        if key in tls:
            out.append(f"{where} [tls] {key} is not for this profile: remove it")
    cert_dir = tls.get("cert_dir")
    inside = isinstance(cert_dir, str) and os.path.normpath(cert_dir).startswith(f"{VAR_RELAY}/")
    if not inside or os.path.normpath(cert_dir) != cert_dir.rstrip("/"):
        out.append(
            f"{where} [tls] cert_dir must be a directory in the mounted {VAR_RELAY}, such as "
            f'"{RELAY_CERT_DIR}" (got {cert_dir!r}): elsewhere the certificate is lost on every restart'
        )
    hostname = tls.get("hostname")
    if not isinstance(hostname, str) or not re.fullmatch(DOMAIN_RE, hostname):
        out.append(f"{where} [tls] hostname must be the relay's lower-case DNS name (got {hostname!r})")
    elif hostname == RELAY_PLACEHOLDERS["hostname"]:
        out.append(f"{where} [tls] hostname is still the example's {hostname}")
    contact = tls.get("contact")
    if not isinstance(contact, str) or not re.fullmatch(EMAIL_RE, contact):
        out.append(f"{where} [tls] contact must be an email address, without mailto: (got {contact!r})")
    elif contact == RELAY_PLACEHOLDERS["contact"]:
        out.append(f"{where} [tls] contact is still the example's {contact}")
    elif reserved_mail_domain(contact):
        out.append(f"{where} [tls] contact {contact}: Let's Encrypt refuses an account on a reserved domain")
    if not isinstance(tls.get("prod_tls"), bool):
        out.append(f"{where} [tls] prod_tls must be true or false")

    access = cfg.get("access", "everyone")
    if access != "everyone":
        if not isinstance(access, dict) or list(access) not in (["allowlist"], ["denylist"]):
            out.append(f'{where} access must be "everyone", {{ allowlist = [...] }} or {{ denylist = [...] }}')
        else:
            kind, ids = next(iter(access.items()))
            if not isinstance(ids, list) or not all(
                isinstance(i, str) and re.fullmatch(r"[0-9a-f]{64}", i) for i in ids
            ):
                out.append(
                    f"{where} access.{kind} must list endpoint IDs, each 64 lowercase hex (`cli whoami` on a node)"
                )
            elif len(set(ids)) != len(ids):
                out.append(f"{where} access.{kind} lists an ID twice")
            elif kind == "allowlist" and not ids:
                out.append(
                    f"{where} the allowlist is empty, so the relay would admit nobody: add your nodes' IDs "
                    '(`sudo compose/decdn-compose cli whoami` on each node), or set access = "everyone" deliberately'
                )
    return out


def bare_bind_problem(what: str, value: object, wildcard_ok: bool = True) -> str | None:
    """A public listener's bare address (iroh-dns-server's bind_addr)."""
    try:
        addr = ipaddress.ip_address(value) if isinstance(value, str) else None
    except ValueError:
        addr = None
    if addr is None:
        return f"{what} = {value!r} is not a bare IP address (no brackets or port)"
    if str(addr) != value:
        return f"{what} = {value!r}: write it in its canonical form, {str(addr)!r}"
    if addr.is_unspecified and not wildcard_ok:
        return f"{what} = {value!r}: not a wildcard here"
    if addr.is_loopback or addr.is_link_local or addr.is_multicast:
        return f"{what} = {value!r}: a loopback, link-local or multicast address serves no peer"
    if isinstance(addr, ipaddress.IPv6Address) and addr.ipv4_mapped:
        return f"{what} = {value!r}: an IPv4-mapped address; write the IPv4 address itself"
    if addr == ipaddress.IPv6Address("::") and bindv6only():
        return (
            f"{what} = {value!r}: this host has net.ipv6.bindv6only=1, so :: serves no IPv4 peer; "
            "use 0.0.0.0 or set the sysctl to 0"
        )
    return None


def dns_problems(path: Path) -> list[str]:
    """What iroh-dns-server would ignore, refuse late, or serve wrongly with."""
    cfg, err = load_toml(path)
    if err:
        return [err]
    out: list[str] = []
    where = f"{path}:"
    tables: dict[str, dict] = {}
    extra = sorted(set(cfg) - DNS_KEYS["the top level"])
    if extra:
        out.append(
            f"{where} unknown key(s) at the top level: {', '.join(extra)} (iroh-dns-server 1.3.0 would ignore them)"
        )
    for name in ("http", "https", "dns", "metrics", "mainline", "zone_store"):
        section = f"[{name}]"
        table = cfg.get(name)
        if not isinstance(table, dict):
            out.append(f"{where} no {section} table (every key is written out: start from the example)")
            table = {}
        extra = sorted(set(table) - DNS_KEYS[section])
        if extra:
            out.append(
                f"{where} unknown key(s) in {section}: {', '.join(extra)} (iroh-dns-server 1.3.0 would ignore them)"
            )
        tables[name] = table
    http, https, dns, metrics = tables["http"], tables["https"], tables["dns"], tables["metrics"]

    rate = cfg.get("pkarr_put_rate_limit")
    if rate == "smart":
        out.append(
            f'{where} pkarr_put_rate_limit = "smart" reads X-Forwarded-For, which a client can forge with no proxy '
            'in front: use "simple" (1.3.0 treats smart as simple anyway)'
        )
    elif rate not in ("simple", "disabled"):
        out.append(f'{where} pkarr_put_rate_limit must be "simple" or "disabled" (got {rate!r})')
    if cfg.get("data_dir") != str(VAR_DNS):
        out.append(
            f"{where} data_dir must be {str(VAR_DNS)!r}, the mounted state directory (got {cfg.get('data_dir')!r}): "
            "elsewhere the records and the certificate are lost on every restart"
        )

    for name, table in (("[http]", http), ("[metrics]", metrics)):
        raw = table.get("bind_addr")
        addr = socket_addr(raw) if name == "[metrics]" else None
        host = addr[0] if addr else None
        if name == "[http]":
            try:
                host = ipaddress.ip_address(raw) if isinstance(raw, str) else None
            except ValueError:
                host = None
        if host is None or not host.is_loopback:
            out.append(f"{where} {name} bind_addr must be loopback (got {raw!r}): never public")
    if http.get("port") != 9118:
        out.append(f"{where} [http] port must be 9118 (`decdn-compose health` reads /healthz there)")
    if metrics.get("disabled") is not False:
        out.append(f"{where} [metrics] disabled must be false")
    metrics_addr = socket_addr(metrics.get("bind_addr"))
    if metrics_addr and metrics_addr[1] != 9117:
        out.append(f"{where} [metrics] bind_addr must use port 9117 (the port check and README assume it)")

    if https.get("port") != 443:
        out.append(f"{where} [https] port must be 443 (Let's Encrypt's TLS-ALPN-01 challenge comes there)")
    problem = bare_bind_problem("[https] bind_addr", https.get("bind_addr", "::"))
    if problem:
        out.append(f"{where} {problem}")
    if https.get("cert_mode") != "lets_encrypt":
        out.append(f'{where} [https] cert_mode must be "lets_encrypt" (got {https.get("cert_mode")!r})')
    domains = https.get("domains")
    hostname = domains[0] if isinstance(domains, list) and len(domains) == 1 else None
    if not isinstance(hostname, str) or not re.fullmatch(DOMAIN_RE, hostname):
        out.append(f"{where} [https] domains must be one lower-case DNS name, the delegated hostname (got {domains!r})")
        hostname = None
    elif hostname == DNS_PLACEHOLDERS["hostname"]:
        out.append(f"{where} [https] domains is still the example's {hostname}")
    contact = https.get("letsencrypt_contact")
    if not isinstance(contact, str) or not re.fullmatch(EMAIL_RE, contact):
        out.append(f"{where} [https] letsencrypt_contact must be an email address, without mailto: (got {contact!r})")
    elif contact == DNS_PLACEHOLDERS["contact"]:
        out.append(f"{where} [https] letsencrypt_contact is still the example's {contact}")
    elif reserved_mail_domain(contact):
        out.append(
            f"{where} [https] letsencrypt_contact {contact}: Let's Encrypt refuses an account on a reserved domain"
        )
    if not isinstance(https.get("letsencrypt_prod"), bool):
        out.append(f"{where} [https] letsencrypt_prod must be true or false (unset means staging)")

    if dns.get("port") != 53:
        out.append(f"{where} [dns] port must be 53")
    bind = dns.get("bind_addr")
    if bind == DNS_PLACEHOLDERS["address"]:
        out.append(f"{where} [dns] bind_addr is still the example's {bind}: this host's address (`init dns` picks it)")
    else:
        problem = bare_bind_problem("[dns] bind_addr", bind)
        if problem:
            out.append(f"{where} {problem}")
    origins = dns.get("origins")
    if not isinstance(origins, list) or not all(isinstance(o, str) for o in origins):
        out.append(f"{where} [dns] origins must be a list of names")
        origins = []
    if "." not in origins:
        out.append(f'{where} [dns] origins must include "." (the static zone is rooted there; 1.3.0 refuses to start)')
    for o in origins:
        if o != "." and not re.fullmatch(DNS_NAME_RE, o):
            out.append(
                f"{where} [dns] origin {o!r} must be a lower-case name with its trailing dot: without it "
                "1.3.0 answers SOA but no record at the apex"
            )
    apexes = {o.rstrip(".") for o in origins if o != "."}
    if hostname and hostname not in apexes and not any(hostname.endswith(f".{a}") for a in apexes):
        out.append(f"{where} [dns] origins do not cover the hostname {hostname} (nodes resolve under it)")
    soa = dns.get("default_soa")
    fields = soa.split() if isinstance(soa, str) else []
    if len(fields) != 7 or not all(f.isdigit() for f in fields[2:]):
        out.append(f'{where} [dns] default_soa must be "<mname> <rname> <serial> <refresh> <retry> <expire> <minimum>"')
    ttl = dns.get("default_ttl")
    if not isinstance(ttl, int) or isinstance(ttl, bool) or ttl <= 0:
        out.append(f"{where} [dns] default_ttl must be a positive number of seconds")
    for key, version in (("rr_a", 4), ("rr_aaaa", 6)):
        if key not in dns:
            continue
        try:
            addr = ipaddress.ip_address(dns[key])
        except (ValueError, TypeError):
            addr = None
        if (
            addr is None
            or addr.version != version
            or addr.is_unspecified
            or addr.is_loopback
            or addr.is_multicast
            or addr.is_link_local
        ):
            out.append(f"{where} [dns] {key} must be a public IPv{version} address (got {dns[key]!r})")
        elif private_address(addr):
            out.append(
                f"{where} [dns] {key} = {dns[key]!r} is private: set the public address the parent zone's glue names"
            )
    if dns.get("rr_a") == DNS_PLACEHOLDERS["address"]:
        out.append(f"{where} [dns] rr_a is still the example's {dns['rr_a']}")
    ns = dns.get("rr_ns")
    if ns is not None and (not isinstance(ns, str) or not re.fullmatch(DNS_NAME_RE, ns)):
        out.append(f"{where} [dns] rr_ns must be an absolute name with its trailing dot (got {ns!r})")
    elif isinstance(ns, str):
        # The server answers A/AAAA/NS only at an origin's apex and reads a name below
        # one as a node key, so an NS name there leaves the delegation unanswerable
        # (the role's "Validate the NS record").
        below = sorted(a for a in apexes if ns.rstrip(".").lower().endswith(f".{a}"))
        if below:
            out.append(
                f"{where} [dns] rr_ns {ns!r} is below the origin {below[0]}., which the server reads as a node "
                "key and cannot answer: use an origin's apex (the hostname) or a name outside every origin"
            )
    at_apex = hostname in apexes or (isinstance(ns, str) and ns.rstrip(".") in apexes)
    if at_apex and not ("rr_a" in dns or "rr_aaaa" in dns):
        out.append(
            f"{where} [dns] no rr_a: this server answers its own hostname, so set rr_a to the host's public IPv4 "
            "(the glue's address; behind NAT, not the bind address)"
        )

    if not isinstance(tables["mainline"].get("enabled"), bool):
        out.append(f"{where} [mainline] enabled must be true or false")
    missing = sorted(DNS_KEYS["[zone_store]"] - set(tables["zone_store"]))
    if missing:
        out.append(f"{where} [zone_store] lacks {', '.join(missing)} (write upstream's defaults, as the example does)")
    return out


def dns_bind(path: Path = DNS_TOML) -> str:
    cfg, _ = load_toml(path)
    dns = cfg.get("dns") if isinstance(cfg.get("dns"), dict) else {}
    return str(dns.get("bind_addr", ""))


def dns_port_problems(bind: str, rows: list[tuple[str, str, int, str]]) -> list[str]:
    """Port 53 held by another process where the DNS listener binds: on its own
    address, or anywhere for a wildcard bind (the role's tasks/ports.yml). A
    resolver on another address (systemd-resolved's stub on 127.0.0.53) is fine,
    unless the bind is a wildcard."""
    wildcard = bind in ("::", "0.0.0.0")
    out = []
    for proto, addr, port, proc in rows:
        if port != 53 or proto not in ("udp", "tcp"):
            continue
        holder_wild = addr in ("*", "0.0.0.0", "::", "[::]")
        if not (wildcard or holder_wild or addr.strip("[]").split("%")[0] == bind):
            continue
        msg = f"{proto}/53 on {addr}, which iroh-dns-server binds ({bind}), is held by {proc}"
        if wildcard and addr.startswith("127.0.0.5"):
            msg += (
                " (where systemd-resolved's stub listens). Bind [dns] to one address (`init dns` picks the default "
                "IPv4) or turn the stub off first (DNSStubListener=no in /etc/systemd/resolved.conf.d/)"
            )
        out.append(msg)
    return list(dict.fromkeys(out))


def relay_ports(path: Path = RELAY_TOML) -> tuple[tuple[str, int], ...]:
    """The relay's listeners as its config sets them (PORTS when it cannot be read)."""
    cfg, err = load_toml(path)
    if err:
        return PORTS["iroh-relay"]
    ports = [("tcp", 80), ("tcp", 443)]
    if cfg.get("enable_quic_addr_discovery") is True:
        ports.append(("udp", 7842))
    metrics = socket_addr(cfg.get("metrics_bind_addr"))
    ports.append(("tcp", metrics[1] if metrics else 9092))
    return tuple(ports)


def service_ports(svc: str) -> tuple[tuple[str, int], ...]:
    if svc == "iroh-relay":
        return relay_ports()
    if svc == "iroh-dns-server":
        # Port 53 is address-aware: dns_port_problems.
        return tuple(p for p in PORTS[svc] if p[1] != 53)
    return PORTS[svc]


def listener_rows(text: str) -> list[tuple[str, str, int, str]]:
    """`ss -Hlntup` -> (proto, local address, port, process) per listener."""
    rows = []
    for line in text.splitlines():
        cols = line.split()
        if len(cols) < 5:
            continue
        m = re.fullmatch(r"(.*):(\d+)", cols[4])
        if m:
            proc = re.search(r'users:\(\("([^"]+)"', line)
            rows.append((cols[0], m[1], int(m[2]), proc[1] if proc else "?"))
    return rows


def listeners() -> list[tuple[str, str, int, str]] | None:
    """Every listener, from `ss`; None without ss."""
    if shutil.which("ss") is None:
        return None
    cp = run(["ss", "-Hlntup"], check=False, capture=True)
    if cp.returncode != 0:
        # An empty answer would read as "nothing holds any port".
        raise Refused(f"`ss -Hlntup` failed (exit {cp.returncode}): cannot check the ports (iproute2 too old?)")
    return listener_rows(cp.stdout)


def check_ports(project: Project) -> list[str]:
    rows = listeners()
    if rows is None:
        warn("`ss` is not installed: skipping the port check")
        return []
    held: dict[tuple[str, int], str] = {}
    for proto, _, port, proc in rows:
        held.setdefault((proto, port), proc)
    out = []
    for svc in sorted(project.services):
        if container_id(svc):
            continue  # it holds its own ports
        for proto, port in service_ports(svc):
            if (proto, port) in held:
                out.append(f"{proto}/{port}, which {svc} binds, is held by {held[(proto, port)]}")
        if svc == "iroh-dns-server":
            out += dns_port_problems(dns_bind(), rows)
    return out


def validate_node(project: Project) -> list[str]:
    """`decdn config validate` against the pinned image, with the daemon's own
    environment file. Its output can name the RPC endpoint, so only a redacted
    copy of a failure is shown."""
    cp = decdn_cli(
        project,
        ["config", "validate", "--config", str(NODE_TOML), "--keystore-password-file", str(NODE_PASSWORD)],
        env_values=node_environment(project),
        extra_mounts=origin_mounts(project),
        quiet=True,
        check=False,
    )
    if cp.returncode == 0:
        return []
    tail = "\n    ".join(redact(cp.stdout or "").strip().splitlines()[-15:])
    return [f"decdn config validate refused {NODE_TOML}:\n    {tail}"]


def node_environment(project: Project) -> dict[str, str]:
    """The node daemon's environment as Compose renders it (decdn-node sets
    nothing inline, so that is decdn.env as Compose reads it), else decdn.env as
    parse_env reads it."""
    rendered = rendered_environments().get("decdn-node")
    if rendered is not None:
        return rendered
    dec_env = project.env_file("DECDN_ENV_FILE")
    return parse_env(dec_env) if dec_env.exists() else {}


def origin_mounts(project: Project) -> list[str]:
    d = project.env.get("DECDN_ORIGIN_DIR")
    return [f"{d}:{ORIGIN_TARGET}:ro"] if d else []


def check(args: argparse.Namespace | None = None, project: Project | None = None) -> Project:
    require_root()
    project = project or Project.load()
    found = problems(project)
    if not found:
        rendered = json.loads(compose("config", "--format", "json", capture=True).stdout)
        journald = sorted(
            n for n, s in rendered.get("services", {}).items() if (s.get("logging") or {}).get("driver") == "journald"
        )
        if journald and not Path("/run/systemd/journal/socket").exists():
            found.append(
                f"no systemd journal on this host, and {', '.join(journald)} log to journald "
                "(README.md, Logs, shows a compose.override.yaml for another driver)"
            )
        found += rendered_origin_problems(rendered)
        found += check_ports(project)
        if "decdn-node" in project.services and not found:
            found += validate_node(project)
    if found:
        raise Refused("preflight failed:\n" + "\n".join(f"  - {p}" for p in found))
    say(f"preflight ok: {', '.join(project.profiles)}")
    return project


# --- sponsord's top-up hold ------------------------------------------------------


# Every probe goes to loopback, never through a proxy: urllib honours http_proxy
# with no loopback bypass, and sudo can carry one in from /etc/environment.
_DIRECT = urllib.request.build_opener(urllib.request.ProxyHandler({}))


def fetch(url: str, timeout: float = 5.0) -> tuple[int, str]:
    """(status, body); status 0 = nothing listening, -1 = no answer."""
    try:
        with _DIRECT.open(url, timeout=timeout) as r:
            return r.status, r.read().decode("utf-8", "replace")
    except urllib.error.HTTPError as e:
        return e.code, ""
    except urllib.error.URLError as e:
        if isinstance(e.reason, ConnectionRefusedError):
            return 0, ""
        return -1, ""
    except (TimeoutError, OSError):
        return -1, ""


def hold_state(status: int, body: str, url: str = SPONSORD_METRICS) -> str | None:
    """None when sponsord holds nothing, else why it must not be stopped.

    A daemon that is not listening yet has never topped up (it binds before it
    starts the keeper); one that answers without the keeper's series, or does not
    answer, is in an unknown state (ansible/roles/sponsord/tasks/topup-hold.yml).
    Stricter than the role, which takes a missing gauge for a binary that predates
    it: Compose runs only pinned images, which all export it, so a missing,
    unparseable or non-finite sample is unknown too, and any held series holds."""
    if status == 0:
        return None
    if status != 200 or not KEEPER_RE.search(body):
        return (
            f"sponsord's /metrics ({url}) did not answer with its keeper series "
            f"(status {status}): its top-up hold state is unknown"
        )
    samples = [line for line in body.splitlines() if line.startswith(HOLD_GAUGE)]
    values = [m[1] for line in samples if (m := HOLD_RE.match(line))]
    try:
        parsed = [float(v) for v in values]
    except ValueError:
        parsed = []
    if not samples or len(values) != len(samples) or not all(math.isfinite(v) for v in parsed) or not parsed:
        return f"sponsord's /metrics ({url}) has no readable {HOLD_GAUGE} sample: its top-up hold state is unknown"
    since = int(max(parsed))
    if since > 0:
        return (
            f"sponsord holds an unconfirmed pool top-up since "
            f"{time.strftime('%Y-%m-%d %H:%M:%S UTC', time.gmtime(since))}: a stop or restart "
            "forgets it and the pool can be refilled twice. Wait until "
            "sponsord_pool_topup_unconfirmed_since_unix is 0 (README.md, Operate)"
        )
    return None


def guard_sponsord(args: argparse.Namespace, action: str) -> None:
    if args.ignore_topup_hold:
        warn("--ignore-topup-hold: not checking sponsord for a held pool top-up")
        return
    cid = container_id("sponsord")
    if not cid:
        return
    url = sponsord_metrics_url(cid)
    if url is None:
        raise Refused(
            "refusing to touch sponsord: the running container's SPONSORD_BIND is not a loopback "
            "host:port, so its top-up hold cannot be read. Override with --ignore-topup-hold."
        )
    for _ in range(3):
        status, body = fetch(url)
        if status != -1:
            break
        time.sleep(2)
    reason = hold_state(status, body, url)
    if reason:
        raise Refused(f"refusing to {action} sponsord: {reason}. Override with --ignore-topup-hold.")


def sponsord_metrics_url(cid: str) -> str | None:
    """The /metrics of the address the running sponsord was started with, not a
    constant: an override can move SPONSORD_BIND, and a probe refused on the old
    port would read as "not listening, holds nothing" (the role probes the running
    process's listener for the same reason)."""
    return bind_metrics_url(container_env(cid).get("SPONSORD_BIND", ""))


def container_env(cid: str) -> dict[str, str]:
    """A running container's environment ({} when it cannot be read)."""
    cp = run(["docker", "inspect", "--format", "{{json .Config.Env}}", cid], check=False, capture=True)
    try:
        entries = json.loads(cp.stdout or "null")
    except ValueError:
        return {}
    if not isinstance(entries, list):
        return {}
    return dict(e.split("=", 1) for e in entries if isinstance(e, str) and "=" in e)


def bind_metrics_url(bind: str) -> str | None:
    return loopback_url(bind, "/metrics")


def loopback_url(bind: str, path: str) -> str | None:
    """http://<bind><path> for a loopback host:port bind, else None."""
    m = re.fullmatch(r"(127(?:\.\d{1,3}){3}):(\d{1,5})", bind)
    return f"http://{m[1]}:{m[2]}{path}" if m else None


# compose.yaml's services: a stop/restart argument outside this set is an
# option's value (`-t 10`), which the guard cannot place, so it is checked.
SERVICES = frozenset(s for svcs in PROFILES.values() for s in svcs)


def touches_sponsord(command: str, rest: list[str]) -> bool:
    """Whether a stop/restart/down would stop the running sponsord. Fails closed:
    anything but a list of known services that leaves sponsord out counts."""
    if command == "down":
        return True
    names = [a for a in rest if not a.startswith("-")]
    return not names or "sponsord" in names or not set(names) <= SERVICES


def up_recreates_sponsord(rest: list[str]) -> bool:
    """Whether `up <rest>` would stop a running sponsord: Compose's own answer,
    from a dry run of the same command (a changed image, env file or setting
    recreates it; --remove-orphans can remove it). A dry run that fails counts as
    yes. Its config hash is no shortcut: `config --hash` and the container's label
    are computed differently on some Compose releases."""
    cid = container_id("sponsord")
    if not cid:
        return False
    name = run(["docker", "inspect", "--format", "{{.Name}}", cid], capture=True).stdout.strip().lstrip("/")
    # Plain progress, so every container's line is printed: a quieter mode would
    # print nothing to match, which would read as "not touched".
    cp = run(compose_argv("--progress", "plain", "--dry-run", "up", "-d", *rest), check=False, quiet=True)
    if cp.returncode != 0:
        return True
    return touched_in_dry_run(cp.stdout, name)


def touched_in_dry_run(output: str, container: str) -> bool:
    return bool(re.search(rf"(?m)\bContainer {re.escape(container)}\s+(Recreate|Stopping|Removing|Killing)\b", output))


# --- service commands ------------------------------------------------------------


def cmd_up(args: argparse.Namespace) -> None:
    check()
    if up_recreates_sponsord(args.rest):
        guard_sponsord(args, "recreate")
    compose("up", "-d", *args.rest)


# The configs a service reads only at start, which nothing but these checks guards
# (the iroh servers ignore unknown keys and fall back to built-in defaults, public
# ones included): `restart` is how an edit is applied, so it runs them first.
CONFIG_CHECKS: dict[str, Callable[[], list[str]]] = {
    "iroh-relay": lambda: relay_problems(RELAY_TOML),
    "iroh-dns-server": lambda: dns_problems(DNS_TOML),
}


def cmd_stopping(args: argparse.Namespace) -> None:
    require_root()
    project = Project.load()
    if args.command == "restart":
        names = [a for a in args.rest if not a.startswith("-")]
        found = [
            p
            for svc, checks in CONFIG_CHECKS.items()
            if svc in project.services and (not names or svc in names or not set(names) <= SERVICES)
            for p in checks()
        ]
        if found:
            raise Refused(
                "refusing to restart with a config the service would misread:\n" + "\n".join(f"  - {p}" for p in found)
            )
    if touches_sponsord(args.command, args.rest):
        guard_sponsord(args, "stop" if args.command == "down" else args.command)
    compose(args.command, *args.rest)


def cmd_config(args: argparse.Namespace) -> None:
    """`docker compose config`, with every environment value that came from an env
    file replaced by <redacted>: Compose merges env_file into `environment:`, so
    the plain command prints DECDN_RPC_URL and the rest in clear. A value written
    inline in compose.yaml (listeners, secret paths) is kept. --services,
    --profiles, --images, --volumes and --networks list names only and pass
    through; any other argument is refused (--environment would print it all)."""
    require_root()
    Project.load()
    listing = {"--services", "--profiles", "--images", "--volumes", "--networks"}
    if args.rest and set(args.rest) <= listing:
        os.execvpe("docker", compose_argv("config", *args.rest), compose_env())
    if args.rest:
        raise Refused("config takes no other arguments here: it prints the redacted model as JSON")
    full = json.loads(compose("config", "--format", "json", capture=True).stdout)
    no_files = {k: "/dev/null" for k in DEFAULT_ENV_FILES}
    inline = json.loads(run(compose_argv("config", "--format", "json"), capture=True, env=compose_env(no_files)).stdout)
    for name, svc in full.get("services", {}).items():
        keep = (inline.get("services", {}).get(name) or {}).get("environment") or {}
        env = svc.get("environment") or {}
        for k in env:
            if keep.get(k) != env[k]:
                env[k] = "<redacted>"
    say(json.dumps(full, indent=2))


def cmd_passthrough(args: argparse.Namespace) -> None:
    require_root()
    Project.load()
    os.execvpe("docker", compose_argv(args.command, *args.rest), compose_env())


def cmd_cli(args: argparse.Namespace) -> None:
    require_root()
    project = Project.load()
    # The node's own config and keystore password, unless the command names its own:
    # without them the CLI looks under $HOME/.decdn and finds no identity.
    cli_args = list(args.rest)
    mounts = origin_mounts(project)
    node_env = node_environment(project)
    with tempfile.TemporaryDirectory(prefix="decdn-cli.") as tmp:
        if "--config" not in cli_args and NODE_TOML.exists():
            config = NODE_TOML
            # On-chain commands read blockchain.rpc_url, which still names the public
            # endpoint `config init` wrote. A copy that says "${DECDN_RPC_URL}" (the
            # loader expands it) gives them yours, from decdn.env: the URL never
            # reaches an argv, a sudo log or shell history. The copy holds no secret.
            if node_env.get("DECDN_RPC_URL"):
                copy = Path(tmp) / "node.toml"
                copy.write_text(with_env_rpc_url(NODE_TOML.read_text()))
                os.chmod(tmp, 0o755)
                copy.chmod(0o644)
                mounts.append(f"{copy}:{CLI_CONFIG}:ro")
                config = Path(CLI_CONFIG)
            cli_args = ["--config", str(config), *cli_args]
        cp = decdn_cli(
            project,
            cli_args,
            cli_env={"DECDN_KEYSTORE_PASSWORD_FILE": str(NODE_PASSWORD)},
            network="host",
            tty=True,
            check=False,
            extra_mounts=mounts,
            env_values=node_env,
        )
    sys.exit(cp.returncode)


CLI_CONFIG = "/run/decdn-cli/node.toml"


def with_env_rpc_url(text: str) -> str:
    """node.toml with [blockchain] rpc_url = "${DECDN_RPC_URL}"."""
    line = 'rpc_url = "${DECDN_RPC_URL}"'
    m = re.search(r"(?ms)^\[blockchain\]\n(.*?)(?=^\[|\Z)", text)
    if not m:
        return text.rstrip("\n") + f"\n\n[blockchain]\n{line}\n"
    body = m[1]
    if re.search(r"(?m)^rpc_url\s*=", body):
        body = re.sub(r"(?m)^rpc_url\s*=.*$", line, body, count=1)
    else:
        body = f"{line}\n{body}"
    return text[: m.start(1)] + body + text[m.end(1) :]


def tls_healthz(domain: str, addr: str = "127.0.0.1") -> str:
    """GET https://<domain>/healthz from the listener on <addr>:443 (Caddy, the
    relay), against the host's trust store: proves the certificate, not just the
    listener."""
    ctx = ssl.create_default_context()
    ctx.minimum_version = ssl.TLSVersion.TLSv1_2
    try:
        with (
            socket.create_connection((addr, 443), timeout=5) as raw,
            ctx.wrap_socket(raw, server_hostname=domain) as s,
        ):
            s.sendall(f"GET /healthz HTTP/1.1\r\nHost: {domain}\r\nConnection: close\r\n\r\n".encode())
            head = s.recv(4096).decode("latin-1").split("\r\n", 1)[0]
            return "ok" if head.split()[1:2] == ["200"] else head or "no answer"
    except (OSError, ssl.SSLError) as e:
        return str(e)


def cmd_health(args: argparse.Namespace) -> None:
    require_root()
    project = Project.load()
    bad = 0

    def report(name: str, ok: bool, detail: str, warn_only: bool = False) -> None:
        nonlocal bad
        bad += not ok and not warn_only
        say(f"{'ok  ' if ok else 'warn' if warn_only else 'FAIL'} {name}: {detail}")

    svcs = project.services
    for svc in sorted(svcs):
        if not container_id(svc):
            report(svc, False, "not running (`decdn-compose ps`, `decdn-compose logs " + svc + "`)")
            svcs = svcs - {svc}
    if "decdn-node" in svcs:
        cp = compose(
            "exec", "-T", "decdn-node", "decdn", "node", "health", "--config", str(NODE_TOML), check=False, capture=True
        )
        report("decdn-node admin RPC", cp.returncode == 0, " ".join(cp.stdout.split()) or "no answer")
        status, _ = fetch("http://127.0.0.1:9090/metrics")
        report("decdn-node metrics", status == 200, f"http://127.0.0.1:9090/metrics status {status}")
    # Each at the bind its running container was started with, not a constant.
    for svc, bind_key in (("sponsord", "SPONSORD_BIND"), ("sponsord-onramp", "ONRAMP_BIND")):
        if svc in svcs:
            url = loopback_url(container_env(container_id(svc)).get(bind_key, ""), "/healthz")
            if url is None:
                report(svc, False, f"its {bind_key} is not a loopback host:port")
                continue
            status, body = fetch(url)
            report(svc, status == 200, f"{url} {status} {body.strip()}")
    if "sponsord" in svcs:
        url = sponsord_metrics_url(container_id("sponsord"))
        reason = hold_state(*fetch(url), url) if url else "its SPONSORD_BIND is not a loopback host:port"
        report("sponsord top-up hold", reason is None, reason or "none")
    if "caddy" in svcs:
        dom = project.env.get("SPONSORD_ONRAMP_DOMAIN", "")
        res = tls_healthz(dom)
        report("caddy", res == "ok", f"https://{dom}/healthz: {res}")
    if "iroh-relay" in svcs:
        for name, ok, detail, warn_only in relay_health(RELAY_TOML):
            report(name, ok, detail, warn_only)
    if "iroh-dns-server" in svcs:
        pinned = not project.env.get("IROH_DNS_SERVER_IMAGE_DIGEST")
        for name, ok, detail, warn_only in dns_health(DNS_TOML, pinned):
            report(name, ok, detail, warn_only)
    if "alloy" in svcs:
        status, body = fetch(ALLOY_READY)
        report("alloy", status == 200, f"{ALLOY_READY} {status} {body.strip()}")
        status, body = fetch(ALLOY_COMPONENTS)
        sick = unhealthy_components(body) if status == 200 else ["(no answer)"]
        report("alloy components", not sick, ", ".join(sick) or "all healthy")
        status, body = fetch(ALLOY_METRICS)
        failed = failed_sends(body) if status == 200 else {"(no answer from /metrics)": 1.0}
        report(
            "alloy delivery",
            not failed,
            ", ".join(f"{k} {v:g}" for k, v in failed.items()) + " (check GC_API_TOKEN and the endpoints)"
            if failed
            else "nothing dropped",
            True,
        )
    sys.exit(1 if bad else 0)


def failed_sends(body: str) -> dict[str, float]:
    """Alloy's dropped/failed-send counters that are above 0, summed per metric."""
    out: dict[str, float] = {}
    for line in body.splitlines():
        m = ALLOY_FAILED_SENDS.match(line)
        if m:
            try:
                out[m[1]] = out.get(m[1], 0.0) + float(m[2])
            except ValueError:
                continue
    return {k: v for k, v in out.items() if v > 0}


def dig_soa(origin: str, addr: str, tcp: bool) -> str:
    """The first field (the mname) of <origin>'s SOA from <addr>:53, or the error."""
    cp = run(
        ["dig", "+norecurse", "+time=2", "+tries=1", "+short", "+tcp" if tcp else "+notcp", "SOA", origin, f"@{addr}"],
        check=False,
        capture=True,
    )
    first = (cp.stdout or "").split()
    return first[0].lower() if cp.returncode == 0 and first else (cp.stdout or "").strip() or "no answer"


def dns_health(path: Path, pinned: bool) -> list[tuple[str, bool, str, bool]]:
    """The role's gate and certificate check: loopback /healthz reporting the
    pinned version (the binary has no --version), each origin's SOA over udp and
    tcp at the DNS bind address (loopback for a wildcard), then
    https://<hostname>/healthz against the host trust store (warn-only on staging)."""
    cfg, err = load_toml(path)
    if err:
        return [("iroh-dns-server", False, err, False)]

    def section(name: str) -> dict:
        v = cfg.get(name)
        return v if isinstance(v, dict) else {}

    https, dns = section("https"), section("dns")
    out = []
    url = "http://127.0.0.1:9118/healthz"
    status, body = fetch(url)
    try:
        version = json.loads(body).get("version", "?") if status == 200 else "?"
    except (ValueError, AttributeError):
        version = "?"
    ok = status == 200 and (version == DNS_VERSION or not pinned)
    out.append(("iroh-dns-server", ok, f"{url} {status}, version {version} (compose.yaml pins {DNS_VERSION})", False))

    bind = str(dns.get("bind_addr", ""))
    addr = "127.0.0.1" if bind in ("::", "0.0.0.0") else bind
    soa = dns.get("default_soa")
    mname = soa.split()[0].lower().rstrip(".") + "." if isinstance(soa, str) and soa.split() else "?"
    origins = [o for o in dns.get("origins", []) if isinstance(o, str) and o != "."]
    if shutil.which("dig") is None:
        out.append(
            ("iroh-dns-server DNS", False, "`dig` is not installed (dnsutils/bind9-dnsutils): not checked", True)
        )
    else:
        for origin in origins:
            for tcp in (False, True):
                got = dig_soa(origin, addr, tcp)
                out.append(
                    (f"iroh-dns-server SOA {origin} {'tcp' if tcp else 'udp'}", got == mname, f"@{addr}: {got}", False)
                )
    domains = https.get("domains")
    hostname = str(domains[0]) if isinstance(domains, list) and domains else ""
    hbind = str(https.get("bind_addr", "::"))
    haddr = "127.0.0.1" if hbind in ("::", "0.0.0.0") else hbind
    res = tls_healthz(hostname, haddr)
    staging = https.get("letsencrypt_prod") is not True
    detail = f"https://{hostname}/healthz via {haddr}: {res}"
    if staging and res != "ok":
        detail += " (letsencrypt_prod = false: Let's Encrypt's staging certificates are never trusted)"
    out.append(("iroh-dns-server certificate", res == "ok", detail, staging))
    return out


def relay_health(path: Path) -> list[tuple[str, bool, str, bool]]:
    """The role's gate and certificate check: loopback /metrics with the relay's
    series, then https://<hostname>/healthz on the relay's own address (loopback
    for a wildcard bind) against the host trust store. A staging certificate is
    never trusted, so with prod_tls = false that check only warns."""
    cfg, err = load_toml(path)
    if err:
        return [("iroh-relay", False, err, False)]
    tls = cfg.get("tls") if isinstance(cfg.get("tls"), dict) else {}
    out = []
    metrics = socket_addr(cfg.get("metrics_bind_addr"))
    if metrics is None:
        out.append(("iroh-relay metrics", False, "metrics_bind_addr is not an address", False))
    else:
        host = f"[{metrics[0]}]" if metrics[0].version == 6 else str(metrics[0])
        url = f"http://{host}:{metrics[1]}/metrics"
        status, body = fetch(url)
        has = RELAY_GATE_METRIC in body
        out.append(
            (
                "iroh-relay metrics",
                status == 200 and has,
                f"{url} {status}{'' if has else f', no {RELAY_GATE_METRIC}'}",
                False,
            )
        )
    https = socket_addr(tls.get("https_bind_addr"))
    addr = "127.0.0.1" if https is None or https[0].is_unspecified else str(https[0])
    hostname = str(tls.get("hostname", ""))
    res = tls_healthz(hostname, addr)
    staging = tls.get("prod_tls") is False
    detail = f"https://{hostname}/healthz via {addr}: {res}"
    if staging and res != "ok":
        detail += " (prod_tls = false: Let's Encrypt's staging certificates are never trusted)"
    out.append(("iroh-relay certificate", res == "ok", detail, staging))
    return out


def unhealthy_components(body: str) -> list[str]:
    """The components Alloy's UI API reports as anything but healthy: a config
    that loads can still fail at run time (an OTTL statement, an unreadable
    journal). A remote-write error is not one: read Alloy's log for those."""
    try:
        components = json.loads(body)
    except ValueError:
        return ["(unreadable component list)"]
    return sorted(
        f"{c.get('localID', '?')} ({(c.get('health') or {}).get('message', '')})".replace(" ()", "")
        for c in components
        if (c.get("health") or {}).get("state") != "healthy"
    )


def backup_paths(project: Project) -> list[Path]:
    svcs = project.services
    paths: list[Path] = []
    if "decdn-node" in svcs:
        paths += [NODE_SECRET, NODE_KEYSTORE, NODE_PASSWORD, NODE_TOML, project.env_file("DECDN_ENV_FILE")]
    if "sponsord" in svcs:
        paths += [
            SD_KEYSTORE,
            SD_PASSWORD,
            SD_TOKEN,
            project.env_file("SPONSORD_SECRET_ENV_FILE"),
            project.env_file("SPONSORD_ENV_FILE"),
        ]
    if "sponsord-onramp" in svcs:
        paths += [SD_TURNSTILE, project.env_file("SPONSORD_ONRAMP_ENV_FILE")]
    if "iroh-relay" in svcs:
        # The config only: the relay generates its ACME account and certificate
        # itself and gets them again on a new host (the Ansible path backs up none).
        paths += [RELAY_TOML]
    if "iroh-dns-server" in svcs:
        # The config only, likewise: nodes republish their records every 5 minutes.
        paths += [DNS_TOML]
    if "alloy" in svcs:
        paths += [project.env_file("ALLOY_ENV_FILE")]
    return paths


def cmd_backup(args: argparse.Namespace) -> None:
    """The active profiles' keys, secrets, node.toml and env files, encrypted on
    this host to age recipients: nothing readable ever touches the disk. Every
    file the profiles need must be there: a backup missing a key is found out
    only at restore time."""
    require_root()
    project = Project.load()
    if shutil.which("age") is None:
        raise Refused("age is not installed (apt install age)")
    paths = backup_paths(project)
    if not paths:
        raise Refused("nothing to back up for COMPOSE_PROFILES=" + ",".join(project.profiles))

    # lstat, not is_file(): tar archives a symlink as the link, so a credential
    # replaced by one would back up nothing restorable.
    def regular(p: Path) -> bool:
        try:
            return stat.S_ISREG(p.lstat().st_mode)
        except FileNotFoundError:
            return False

    missing = [str(p) for p in paths if not regular(p)]
    if missing:
        raise Refused(
            f"not backing up an incomplete set: {', '.join(missing)} missing or not a regular file "
            "(a symlink would be archived as the link) (`decdn-compose check`)"
        )
    out = Path(args.output or f"decdn-{socket.gethostname()}-{time.strftime('%Y%m%dT%H%M%SZ', time.gmtime())}.tar.age")
    if out.exists():
        raise Refused(f"{out} exists")
    recipients = [a for r in args.recipient for a in ("-r", r)]
    old = os.umask(0o077)
    try:
        tar = subprocess.Popen(
            ["tar", "-C", "/", "--numeric-owner", "-czf", "-", *[str(p.relative_to("/")) for p in paths]],
            stdout=subprocess.PIPE,
        )
        age = subprocess.run(["age", *recipients, "-o", str(out)], stdin=tar.stdout)
        tar.stdout.close()  # type: ignore[union-attr]
        if tar.wait() != 0 or age.returncode != 0:
            out.unlink(missing_ok=True)
            raise Refused("backup failed; no archive was left behind")
    finally:
        os.umask(old)
    say(f"wrote {out} ({len(paths)} files): {', '.join(map(str, paths))}")
    say(f"test it: age -d -i <key> {out} | tar -tz")


