# iroh-dns-server's configuration for the Compose `dns` profile (README.md, "An iroh
# DNS server"): `decdn-compose init dns` installs it as
# /etc/iroh-dns-server/config.toml (root, 0644; nothing in it is secret) with your
# hostname, contact and DNS address filled in. It writes the keys
# ansible/roles/iroh_dns_server's template writes, upstream defaults included.
#
# iroh-dns-server 1.3.0 ignores keys it does not know, so `decdn-compose check`
# refuses a key the binary does not define, the loopback listeners moved off
# loopback, an origin without its trailing dot (it would answer no record at its
# apex), a missing "." origin (it refuses to start), "smart" rate limiting and a
# wildcard DNS bind while systemd-resolved's stub holds port 53. Restart the server
# after an edit: `decdn-compose restart iroh-dns-server`.

# The record store (signed-packets-1.db) and cert_cache/ (the ACME account and
# certificates): the mounted state directory, so both survive a restart.
data_dir = "/var/lib/iroh-dns-server"
# PUT /pkarr, per client address: "simple" (a burst of 2, then one every 4 s) or
# "disabled". Not "smart": it reads X-Forwarded-For, which a client can forge with
# no proxy in front.
pkarr_put_rate_limit = "simple"

# Plain http, loopback only: `decdn-compose health` reads the version at /healthz.
[http]
port = 9118
bind_addr = "127.0.0.1"

# The public pkarr relay (PUT/GET /pkarr/<z32>) and DNS-over-HTTPS (/dns-query).
# Port 443 is fixed: Let's Encrypt's TLS-ALPN-01 challenge comes to it. "::" is
# every address (IPv4 too, unless net.ipv6.bindv6only=1); "0.0.0.0" on an IPv4-only
# host, or one of the host's own addresses.
[https]
port = 443
bind_addr = "::"
domains = ["dns.example.org"]
cert_mode = "lets_encrypt"
# The Let's Encrypt account's email address, without mailto: (required).
letsencrypt_contact = "admin@example.org"
# false: Let's Encrypt's staging CA, for a trial run. Its certificates are never
# trusted.
letsencrypt_prod = true

# The public DNS server, udp and tcp on ONE address (upstream takes one bind_addr
# for both). The host's default IPv4 address keeps systemd-resolved's stub on
# 127.0.0.53:53 working; "::" or "0.0.0.0" also serve IPv6 / every address, but
# then nothing else may hold port 53 (DNSStubListener=no).
[dns]
port = 53
bind_addr = "192.0.2.1"
# Fully qualified, with the trailing dot: in 1.3.0 an origin without it answers SOA
# but not the rr_a/rr_aaaa/rr_ns records at its apex. "." comes last: the static
# zone is rooted there and the server refuses to start without it.
origins = ["dns.example.org.", "."]
# "<mname> <rname> <serial> <refresh> <retry> <expire> <minimum>". The serial is a
# constant: the zone is rebuilt at start, never transferred.
default_soa = "dns.example.org. hostmaster.dns.example.org. 0 10800 3600 604800 3600"
# TTL of the node records it answers, in seconds: short, so a node that moves is
# found at its new address soon.
default_ttl = 30
# The A record at each origin apex: the PUBLIC IPv4 address the parent zone's glue
# names (on a host behind 1:1 NAT, not the DNS bind address). Add rr_aaaa for IPv6.
rr_a = "192.0.2.1"
# The NS record at each origin apex, absolute: the hostname itself, whose address
# rr_a answers, so the delegation needs a single glue record.
rr_ns = "dns.example.org."

# Loopback only (upstream's default too, pinned here).
[metrics]
disabled = false
bind_addr = "127.0.0.1:9117"

# The BitTorrent mainline DHT as a lookup fallback: off. deCDN nodes publish to
# their pkarr_url only, never to the DHT, so it finds nothing for them, while
# every public query for an unknown key would start a DHT lookup from this host.
[mainline]
enabled = false

# Upstream's defaults (src/store/signed_packets.rs): a record a node has not
# republished for 7 days is dropped.
[zone_store]
max_batch_size = 65536
max_batch_time = "1s"
eviction = "7days"
eviction_interval = "10s"
