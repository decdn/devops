# Template for /etc/decdn/decdn.env (root:root 0600). Docker reads it as root before
# starting the container, so it never needs to be readable by the decdn account.
# One KEY=value per line, no quotes, no `export`.
#
# The RPC endpoint. It may embed a provider API key, which is why it lives here and
# not in node.toml. Overrides blockchain.rpc_url.
DECDN_RPC_URL=
# For an S3 cache origin with credentials from the environment:
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
